-  fragmentNormal = normalize(mat3(transpose(inverse(modelView))) * vNormal);
+  // As pbr_instanced.vert: the model's inverse transpose from its cofactors; the view is rigid.
+  mat3 m = transpose(mat3(modelTransform));  // rows of the model's rotation and scale
+  vec3 c0 = cross(m[1], m[2]);
+  vec3 normal = vec3(dot(c0, vNormal), dot(cross(m[2], m[0]), vNormal), dot(cross(m[0], m[1]), vNormal)) / dot(m[0], c0);
+  fragmentNormal = normalize(mat3(cameraTransforms.view) * normal);
 
   texUv = vec2(textureTransform * vec4(vTexCoord, 0.0, 1.0));
   penTexUv = vUnwrappedTexCoord;
