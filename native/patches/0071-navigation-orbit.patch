+// The surface drawn under the cursor, from the main view's depth: what the view shows, instanced
+// trees and impostors included. The nearest within 4 pixels, so a press on or beside a trunk or
+// a branch takes it rather than what shows through beside it. False over the sky.
+bool WbView3D::surfaceUnderCursor(const QPoint &cursor, WbVector3 &point) const {
+  WrViewport *const viewport = wr_scene_get_viewport(wr_scene_get_instance());
+  WrFrameBuffer *const frameBuffer = viewport ? wr_viewport_get_frame_buffer(viewport) : NULL;
+  if (!frameBuffer)
+    return false;
+  const int w = wr_viewport_get_width(viewport), h = wr_viewport_get_height(viewport);
+  float nearest = 1.0f;
+  int x = -1, y = -1;
+  WbWrenOpenGlContext::makeWrenCurrent();
+  for (int dy = -4; dy <= 4; dy += 2) {
+    for (int dx = -4; dx <= 4; dx += 2) {
+      const int px = cursor.x() + dx, py = cursor.y() + dy;
+      if (px < 0 || py < 0 || px >= w || py >= h)
+        continue;
+      float depth = 1.0f;
+      wr_frame_buffer_copy_depth_pixel(frameBuffer, px, py, &depth, true);
+      if (depth < nearest) {
+        nearest = depth;
+        x = px;
+        y = py;
+      }
+    }
+  }
+  WbWrenOpenGlContext::doneWren();
+  if (x < 0)
+    return false;
+
+  const WbVector3 screen(2.0 * x / w - 1.0, 2.0 * (h - y - 1) / h - 1.0, nearest);
+  mWorld->viewpoint()->toWorld(screen, point);
+  return true;
+}
