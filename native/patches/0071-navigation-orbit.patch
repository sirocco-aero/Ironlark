+bool WbViewpoint::isWithinBounds(const WbVector3 &point) const {
+  const WbVector3 &low = mBoundsMin->value(), &high = mBoundsMax->value();
+  for (int i = 0; i < 3; ++i)
+    if (low[i] < high[i] && (point[i] < low[i] || point[i] > high[i]))
+      return false;
+  return true;
+}
