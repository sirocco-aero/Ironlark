+#include "WbWrenScatteringFog.hpp"
+
+#include "WbWrenOpenGlContext.hpp"
+#include "WbWrenPostProcessingEffects.hpp"
+#include "WbWrenShaders.hpp"
+
+#include <wren/frame_buffer.h>
+#include <wren/post_processing_effect.h>
+#include <wren/texture.h>
+#include <wren/texture_2d.h>
+#include <wren/viewport.h>
+
+#include <QtGui/QImage>
+
+static WbWrenScatteringFog::MediumProvider gMediumProvider = NULL;
+
+void WbWrenScatteringFog::setMediumProvider(MediumProvider provider) {
+  gMediumProvider = provider;
+}
+
+bool WbWrenScatteringFog::sceneMedium(Medium *medium) {
+  return gMediumProvider && gMediumProvider(medium);
+}
+
+WbWrenScatteringFog::WbWrenScatteringFog() :
+  WbWrenAbstractPostProcessingEffect(),
+  mPass(NULL),
+  mOcclusionTexture(NULL),
+  mMedium() {
+}
+
+WbWrenScatteringFog::~WbWrenScatteringFog() {
+  detachFromViewport();
+  wr_texture_delete(WR_TEXTURE(mOcclusionTexture));
+}
+
+void WbWrenScatteringFog::loadOcclusion(const QString &path) {
+  QImage image;
+  if (!path.isEmpty())
+    image.load(path);
+  if (image.isNull()) {  // no map: a single fully visible texel
+    image = QImage(1, 1, QImage::Format_ARGB32);
+    image.fill(0xFFFFFFFF);
+  } else
+    image = image.convertToFormat(QImage::Format_ARGB32);
+
+  WbWrenOpenGlContext::makeWrenCurrent();
+  WrTexture2d *texture = wr_texture_2d_new();
+  wr_texture_set_size(WR_TEXTURE(texture), image.width(), image.height());
+  wr_texture_2d_set_data(texture, reinterpret_cast<const char *>(image.constBits()));
+  wr_texture_setup(WR_TEXTURE(texture));
+  WbWrenOpenGlContext::doneWren();
+
+  WrTexture2d *previous = mOcclusionTexture;
+  mOcclusionTexture = texture;
+  mOcclusionPath = path;
+  if (mHasBeenSetup)
+    setup(mWrenViewport);  // rebuild the pass around the new input texture
+  wr_texture_delete(WR_TEXTURE(previous));
+}
+
+void WbWrenScatteringFog::setup(WrViewport *viewport) {
+  if (mWrenPostProcessingEffect) {
+    if (mWrenViewport == viewport)
+      wr_viewport_remove_post_processing_effect(mWrenViewport, mWrenPostProcessingEffect);
+    wr_post_processing_effect_delete(mWrenPostProcessingEffect);
+    mWrenPostProcessingEffect = NULL;
+  }
+
+  mWrenViewport = viewport;
+  if (!mOcclusionTexture) {
+    mHasBeenSetup = false;
+    loadOcclusion(mOcclusionPath);
+  }
+  const float width = wr_viewport_get_width(mWrenViewport);
+  const float height = wr_viewport_get_height(mWrenViewport);
+  WrTexture *depthTexture = WR_TEXTURE(wr_frame_buffer_get_depth_texture(wr_viewport_get_frame_buffer(mWrenViewport)));
+
+  mWrenPostProcessingEffect = WbWrenPostProcessingEffects::scatteringFog(width, height, WR_TEXTURE_INTERNAL_FORMAT_RGB16F,
+                                                                         depthTexture, WR_TEXTURE(mOcclusionTexture));
+  mPass = wr_post_processing_effect_get_pass(mWrenPostProcessingEffect, "scatteringFog");
+
+  WbWrenOpenGlContext::makeWrenCurrent();
+  wr_viewport_add_post_processing_effect(mWrenViewport, mWrenPostProcessingEffect);
+  wr_post_processing_effect_setup(mWrenPostProcessingEffect);
+  WbWrenOpenGlContext::doneWren();
+
+  mHasBeenSetup = true;
+  applyParametersToWren();
+}
+
+void WbWrenScatteringFog::detachFromViewport() {
+  if (mWrenViewport && mWrenPostProcessingEffect) {
+    wr_viewport_remove_post_processing_effect(mWrenViewport, mWrenPostProcessingEffect);
+    wr_post_processing_effect_delete(mWrenPostProcessingEffect);
+  }
+  mWrenPostProcessingEffect = NULL;
+  mWrenViewport = NULL;
+  mPass = NULL;
+  mHasBeenSetup = false;
+}
+
+void WbWrenScatteringFog::update(const Medium &medium) {
+  mMedium = medium;
+  if (mMedium.occlusionPath != mOcclusionPath)
+    loadOcclusion(mMedium.occlusionPath);
+  applyParametersToWren();
+}
+
+void WbWrenScatteringFog::applyParametersToWren() {
+  if (!mPass)
+    return;
+
+  WbWrenOpenGlContext::makeWrenCurrent();
+  const struct {
+    const char *name;
+    const float *value;
+  } vectors[] = {{"scattering", mMedium.scattering},
+                 {"ambient", mMedium.ambient},
+                 {"boxMin", mMedium.boxMin},
+                 {"boxMax", mMedium.boxMax},
+                 {"sunDirection0", mMedium.sunDirection[0]},
+                 {"sunRadiance0", mMedium.sunRadiance[0]},
+                 {"sunDirection1", mMedium.sunDirection[1]},
+                 {"sunRadiance1", mMedium.sunRadiance[1]},
+                 {"occlusionRect", mMedium.occlusionRect},
+                 {"occlusionHeight", mMedium.occlusionHeight},
+                 {"haze", mMedium.haze}};
+  for (const auto &v : vectors)
+    wr_post_processing_effect_pass_set_program_parameter(mPass, v.name, reinterpret_cast<const char *>(v.value));
+  for (int i = 0; i < 16; ++i)
+    wr_post_processing_effect_pass_set_program_parameter(mPass, WbWrenShaders::horizonUniformName(i),
+                                                         reinterpret_cast<const char *>(mMedium.horizon[i]));
+  for (int i = 0; i < 72; ++i)
+    wr_post_processing_effect_pass_set_program_parameter(mPass, WbWrenShaders::ambientTableUniformName(i),
+                                                         reinterpret_cast<const char *>(mMedium.ambientTable[i]));
+  WbWrenOpenGlContext::doneWren();
+}
