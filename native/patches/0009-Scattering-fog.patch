diff --git a/src/webots/nodes/WbFog.cpp b/src/webots/nodes/WbFog.cpp
index 601844983966aea58c5bfe6ce13094300f9b66ee..a11012489b5cd617ddf18b23c0cdc02244e47fb5 100644
--- a/src/webots/nodes/WbFog.cpp
+++ b/src/webots/nodes/WbFog.cpp
@@ -15,25 +15,212 @@
 #include "WbFog.hpp"
 
 #include "WbFieldChecker.hpp"
+#include "WbMFString.hpp"
+#include "WbMFVector3.hpp"
 #include "WbSFColor.hpp"
 #include "WbSFDouble.hpp"
 #include "WbSFString.hpp"
+#include "WbSFVector2.hpp"
+#include "WbSFVector3.hpp"
+#include "WbUrl.hpp"
 #include "WbWorld.hpp"
 #include "WbWrenRenderingContext.hpp"
+#include "WbWrenScatteringFog.hpp"
+
+#include "WbDirectionalLight.hpp"
+#include "WbLight.hpp"
 
 #include <wren/scene.h>
 
 #include <cassert>
+#include <cmath>
 #include <limits>
 
 QList<WbFog *> WbFog::cFogList;
 
+static float srgbToLinear(double c) {
+  return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);
+}
+
+// The world's scattering medium, for every view that renders it (WbViewpoint, Camera devices).
+static bool scatteringMedium(WbWrenScatteringFog::Medium *medium) {
+  const WbFog *fog = WbFog::fogInstance();
+  if (!fog || !fog->isScattering())
+    return false;
+
+  // Webots colors are sRGB; the medium works in linear light.
+  const WbRgb &albedo = fog->color();
+  const double density = fog->density();
+  medium->scattering[0] = density * srgbToLinear(albedo.red());
+  medium->scattering[1] = density * srgbToLinear(albedo.green());
+  medium->scattering[2] = density * srgbToLinear(albedo.blue());
+  medium->scattering[3] = fog->anisotropy();
+  const WbRgb &ambient = fog->ambientColor();
+  medium->ambient[0] = srgbToLinear(ambient.red());
+  medium->ambient[1] = srgbToLinear(ambient.green());
+  medium->ambient[2] = srgbToLinear(ambient.blue());
+
+  // A zero size leaves the medium unbounded along that axis: boxSize 0 0 h is a layer.
+  const WbVector3 &center = fog->boxCenter();
+  const WbVector3 &size = fog->boxSize();
+  bool bounded = false;
+  for (int i = 0; i < 3; ++i) {
+    const double half = size[i] > 0.0 ? 0.5 * size[i] : 1e9;
+    bounded = bounded || size[i] > 0.0;
+    medium->boxMin[i] = center[i] - half;
+    medium->boxMax[i] = center[i] + half;
+  }
+  // w: > 0 when bounded, the falloff sideways; and upwards and downwards.
+  medium->boxMin[3] = bounded ? qMax(fog->boxFalloffHorizontal(), 1e-4) : 0.0f;
+  medium->boxMax[3] = fog->boxFalloff();
+
+  // Scattered sky light per view direction: the 9 x 8 table as given.
+  if (fog->ambientRadianceCount() == 72)
+    for (int i = 0; i < 72; ++i) {
+      for (int c = 0; c < 3; ++c)
+        medium->ambientTable[i][c] = fog->ambientRadiance(i)[c];
+      medium->ambientTable[i][3] = 1.0f;
+    }
+
+  // The horizon's radiance, resampled to 16 azimuths.
+  const int horizonCount = fog->horizonCount();
+  for (int i = 0; i < 16; ++i) {
+    if (!horizonCount)
+      break;
+    const double position = i * horizonCount / 16.0;
+    const int a = static_cast<int>(position) % horizonCount, b = (a + 1) % horizonCount;
+    const double t = position - static_cast<int>(position);
+    for (int c = 0; c < 3; ++c)
+      medium->horizon[i][c] = (1.0 - t) * fog->horizonRadiance(a)[c] + t * fog->horizonRadiance(b)[c];
+    medium->horizon[i][3] = 1.0f;
+  }
+
+  int sun = 0;
+  foreach (const WbLight *light, WbLight::lights()) {
+    const WbDirectionalLight *directional = dynamic_cast<const WbDirectionalLight *>(light);
+    if (!directional || !directional->isOn() || sun >= 2)
+      continue;
+    WbVector3 toLight = -directional->direction();
+    toLight.normalize();
+    const WbRgb &c = directional->color();
+    const double intensity = directional->intensity();
+    for (int i = 0; i < 3; ++i)
+      medium->sunDirection[sun][i] = toLight[i];
+    medium->sunDirection[sun][3] = 1.0f;
+    medium->sunRadiance[sun][0] = intensity * srgbToLinear(c.red());
+    medium->sunRadiance[sun][1] = intensity * srgbToLinear(c.green());
+    medium->sunRadiance[sun][2] = intensity * srgbToLinear(c.blue());
+    ++sun;
+  }
+
+  medium->occlusionPath = fog->sunOcclusionPath();
+  if (!medium->occlusionPath.isEmpty()) {
+    medium->occlusionRect[0] = fog->sunOcclusionMin().x();
+    medium->occlusionRect[1] = fog->sunOcclusionMin().y();
+    medium->occlusionRect[2] = fog->sunOcclusionMax().x();
+    medium->occlusionRect[3] = fog->sunOcclusionMax().y();
+    medium->occlusionHeight[0] = fog->sunOcclusionHeight().x();
+    medium->occlusionHeight[1] = fog->sunOcclusionHeight().y();
+  }
+
+  medium->haze[0] = fog->hazeDistance();
+
+  return true;
+}
