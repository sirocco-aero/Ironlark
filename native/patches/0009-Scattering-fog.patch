 # The Fog node provides a way to simulate atmospheric effects by blending objects with
 # the color specified by the color field based on the distances of the various objects from the camera.
+# fogType "SCATTERING" instead simulates a lit participating medium: scattering coefficient
+# density * color per metre, a Henyey-Greenstein phase with the given anisotropy, lit by the
+# directional lights and ambientColor, optionally bounded by a box (a zero size leaves that axis
+# unbounded, so boxSize 0 0 h is a horizontal layer; outside the box, density decays exponentially
+# over boxFalloff metres, sideways over boxFalloffHorizontal when it is not 0) and shadowed by a top-down
+# sun occlusion map (R: visibility at the ground, G: ground height between sunOcclusionHeight).
+# horizonRadiance: linear sky radiance just above the horizon at evenly spaced azimuths from +x,
+# counterclockwise; far haze converges to it, so it meets the sky at the horizon without a line.
+# ambientRadiance: the sky light the medium scatters along each view direction (the sky integrated
+# against its phase), 9 elevations (-90 to 90 degrees) by 8 azimuths (from +x, counterclockwise);
+# in place of ambientColor, which scatters the same in every direction.
+# hazeDistance: geometry seen past the box's sides takes the horizon's colour over this distance
+# (e^-1 of it left), as distant land in clear air; 0 for none.
 
 Fog {
-  w3dField SFColor                                           color           1 1 1
-  w3dField SFString{"LINEAR", "EXPONENTIAL", "EXPONENTIAL2"} fogType         "LINEAR"
-  w3dField SFFloat                                           visibilityRange 0
+  w3dField SFColor                                                         color              1 1 1
+  w3dField SFString{"LINEAR", "EXPONENTIAL", "EXPONENTIAL2", "SCATTERING"} fogType            "LINEAR"
+  w3dField SFFloat                                                         visibilityRange    0
+  field    SFFloat                                                         density            0
+  field    SFFloat                                                         anisotropy         0
+  field    SFVec3f                                                         boxCenter          0 0 0
+  field    SFVec3f                                                         boxSize            0 0 0
+  field    SFFloat                                                         boxFalloff         0
+  field    SFFloat                                                         boxFalloffHorizontal 0
+  field    SFColor                                                         ambientColor       0 0 0
+  field    MFString                                                        sunOcclusionUrl    []
+  field    SFVec2f                                                         sunOcclusionMin    0 0
+  field    SFVec2f                                                         sunOcclusionMax    0 0
+  field    SFVec2f                                                         sunOcclusionHeight 0 0
+  field    MFVec3f                                                         horizonRadiance    []
+  field    MFVec3f                                                         ambientRadiance    []
+  field    SFFloat                                                         hazeDistance       0
 }
diff --git a/resources/wren/shaders/scattering_fog.frag b/resources/wren/shaders/scattering_fog.frag
new file mode 100644
index 0000000000000000000000000000000000000000..208fa2257478edff4e73c45967c70cf9cb6f0e2a
--- /dev/null
+++ b/resources/wren/shaders/scattering_fog.frag
@@ -0,0 +1,274 @@
+#version 330 core
+
+precision highp float;
+
+// Single-scattering fog in a box, lit by up to two directional lights and an
+// ambient term, like a homogeneous volume-scatter medium in a path tracer.
+// Sun visibility inside the medium comes from an optional top-down map baked
+// through the canopy: R = visibility at the ground, G = ground height.
+
+in vec2 texUv;
+
+layout(location = 0) out vec4 result;
+
+uniform sampler2D inputTextures[3];  // 0: HDR color, 1: depth, 2: sun occlusion
+
+layout(std140) uniform CameraTransforms {
+  mat4 view;
+  mat4 projection;
+  mat4 infiniteProjection;
+}
+cameraTransforms;
+
+uniform vec4 scattering;      // rgb: scattering coefficient per metre, a: anisotropy
+uniform vec4 ambient;         // rgb: isotropic ambient radiance
+uniform vec4 boxMin;          // xyz; w > 0 when the medium is bounded: outside the box, density decays sideways over w
+uniform vec4 boxMax;          // w: and above and below it, over this distance
+uniform vec4 sunDirection0;   // xyz: world direction towards the light, w: enabled
+uniform vec4 sunRadiance0;    // rgb: color * intensity
+uniform vec4 sunDirection1;
+uniform vec4 sunRadiance1;
+uniform vec4 occlusionRect;   // xy: world min, zw: world max; zero when absent
+uniform vec2 occlusionHeight; // ground height encoded by G = 0 and G = 1
+// Baked light visibility layers (Background.lightOcclusion*, see pbr.frag): when present, they
+// light the medium in place of the sun occlusion map.
+uniform sampler2DArray lightOcclusion;
+uniform sampler2DArrayShadow shadowMap;  // unit 14: the shadowed sun's cascades (see pbr.frag)
+layout(std140) uniform Shadows {
+  mat4 lightViewProjection[3];
+  vec4 splits;
+  vec4 texelSizes;
+  vec4 params;
+  vec4 occlusionRect;
+  vec4 occlusionParams;
+  vec4 occlusionHeights[2];
+}
+shadows;
+
+uniform vec4 ambientTable[72];  // scattered sky light, 9 elevations (-90..90) x 8 azimuths; w: 1 when given
+
+uniform vec4 horizon[16];     // rgb: radiance just above the horizon, azimuth i * 22.5 deg; w: 1 when given
+
+// Haze over the land past the medium's box (Fog.hazeDistance): x, the distance over which geometry
+// seen past the box's sides takes the horizon's colour (e^-1 of it left); 0 without.
+uniform vec4 haze;
+
+const float PI = 3.14159265359;
+const int STEPS = 32;
+const float MAX_DISTANCE = 400.0;  // marched with sun occlusion
+const int FAR_STEPS = 8;
+const float HORIZON = 20000.0;     // beyond MAX_DISTANCE, unoccluded: haze out to the horizon
+
+// Far haze converges to the sky just above the horizon in that direction, so the two meet
+// without a line; without horizon radiance, to the medium's own lighting.
+vec3 horizonRadiance(vec3 direction, vec3 fallback) {
+  if (horizon[0].w <= 0.0)
+    return fallback;
+  float position = mod(atan(direction.y, direction.x) / (2.0 * PI) * 16.0 + 16.0, 16.0);
+  int a = int(position) % 16;
+  return mix(horizon[a].rgb, horizon[(a + 1) % 16].rgb, fract(position));
+}
+
+// Full inside the box; outside, decaying exponentially with the distance to it (boxFalloff),
+// so the medium has no hard faces: from above, near-level rays gather haze towards the horizon.
+// Sky light scattered along a view direction: the table, bilinear; without it, the isotropic ambient.
+vec3 ambientRadiance(vec3 direction) {
+  if (ambientTable[0].w <= 0.0)
+    return ambient.rgb;
+  float e = clamp((asin(clamp(direction.z, -1.0, 1.0)) / PI + 0.5) * 8.0, 0.0, 8.0);
+  float a = mod(atan(direction.y, direction.x) / (2.0 * PI) * 8.0 + 8.0, 8.0);
+  int e0 = min(int(e), 7), a0 = int(a) % 8, a1 = (a0 + 1) % 8;
+  float fe = e - float(e0), fa = fract(a);
+  vec3 low = mix(ambientTable[e0 * 8 + a0].rgb, ambientTable[e0 * 8 + a1].rgb, fa);
+  vec3 high = mix(ambientTable[(e0 + 1) * 8 + a0].rgb, ambientTable[(e0 + 1) * 8 + a1].rgb, fa);
+  return mix(low, high, fe);
+}
+
+float density(vec3 p) {
+  if (boxMin.w <= 0.0)
+    return 1.0;
+  vec3 outside = max(max(boxMin.xyz - p, p - boxMax.xyz), vec3(0.0));
+  return exp(-max(max(outside.x, outside.y) / boxMin.w, outside.z / max(boxMax.w, 1e-4)));
+}
+
+float henyeyGreenstein(float cosTheta, float g) {
+  float d = 1.0 + g * g - 2.0 * g * cosTheta;
+  return (1.0 - g * g) / (4.0 * PI * d * sqrt(d));
+}
+
+// Interleaved gradient noise: decorrelates step offsets between neighbouring pixels.
+float dither(vec2 pixel) {
+  return fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
+}
+
+vec2 occlusionUv(vec2 p) {
+  return (p - occlusionRect.xy) / (occlusionRect.zw - occlusionRect.xy);
+}
+
+float groundHeight(vec2 p) {
+  return mix(occlusionHeight.x, occlusionHeight.y, textureLod(inputTextures[2], occlusionUv(p), 0.0).g);
+}
+
+// Follow the sun ray from p down to the ground, where the canopy bake stored
+// how much sunlight gets through.
+// The shadowed sun's visibility at p from its cascaded shadow maps: sharp shafts through the
+// canopy, as a path tracer sees them; baked where the cascades end.
+float shadowMapVisibility(vec3 p, float baked) {
+  if (shadows.params.x <= 0.0)
+    return baked;
+  float distance = -(cameraTransforms.view * vec4(p, 1.0)).z;
+  if (distance >= shadows.splits.z)
+    return baked;
+  int cascade = distance < shadows.splits.x ? 0 : (distance < shadows.splits.y ? 1 : 2);
+  vec4 light = shadows.lightViewProjection[cascade] * vec4(p, 1.0);
+  vec3 c = light.xyz / light.w * 0.5 + 0.5;
+  float lit = texture(shadowMap, vec4(c.xy, float(cascade), c.z));
+  float fade = clamp((shadows.splits.z - distance) / (0.1 * shadows.splits.z), 0.0, 1.0);
+  // The maps hold the casters near the viewer; the bake, the whole forest between here and a low
+  // sun. The air is in the shade of either.
+  return min(baked, mix(baked, lit, fade));
+}
+
+// As bakedVisibility() in pbr.frag, at p: R sky, G second sun, B main sun, A overhead.
+vec4 bakedVisibility(vec3 p) {
+  int count = int(shadows.occlusionParams.x);
+  if (count <= 0)
+    return vec4(1.0);
+  vec2 uv = (p.xy - shadows.occlusionRect.xy) / (shadows.occlusionRect.zw - shadows.occlusionRect.xy);
+  if (shadows.occlusionParams.w > 0.0)
+    uv = 1.0 - abs(mod(uv, 2.0) - 1.0);
+  else if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
+    return vec4(1.0);
+  float ground = textureLod(lightOcclusion, vec3(uv, float(count)), 0.0).r;
+  float height = p.z - mix(shadows.occlusionParams.y, shadows.occlusionParams.z, ground);
+  // The layer pair around height, found without indexing the heights by a variable (count <= 8).
+  float h[8] = float[8](shadows.occlusionHeights[0].x, shadows.occlusionHeights[0].y, shadows.occlusionHeights[0].z,
+                        shadows.occlusionHeights[0].w, shadows.occlusionHeights[1].x, shadows.occlusionHeights[1].y,
+                        shadows.occlusionHeights[1].z, shadows.occlusionHeights[1].w);
+  if (height <= h[0])
+    return textureLod(lightOcclusion, vec3(uv, 0.0), 0.0);
+  int above = count;  // first layer above height
+  float bottom = h[0], top = h[0];
+  for (int k = 7; k >= 1; --k) {
+    if (k < count && height < h[k]) {
+      above = k;
+      bottom = h[k - 1];
+      top = h[k];
+    }
+  }
+  if (above < count)
+    return mix(textureLod(lightOcclusion, vec3(uv, float(above - 1)), 0.0), textureLod(lightOcclusion, vec3(uv, float(above)), 0.0),
+               (height - bottom) / (top - bottom));
+  float last = h[0];
+  for (int k = 1; k < 8; ++k)
+    if (k == count - 1)
+      last = h[k];
+  return mix(textureLod(lightOcclusion, vec3(uv, float(count - 1)), 0.0), vec4(1.0), clamp((height - last) / 10.0, 0.0, 1.0));
+}
+
+float sunVisibility(vec3 p, vec3 toSun) {
+  if (occlusionRect.z <= occlusionRect.x || toSun.z <= 0.01)
+    return 1.0;
+  vec3 q = p - toSun * ((p.z - groundHeight(p.xy)) / toSun.z);
+  q = p - toSun * ((p.z - groundHeight(q.xy)) / toSun.z);
+  vec2 uv = occlusionUv(q.xy);
+  if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
+    return 1.0;
+  return textureLod(inputTextures[2], uv, 0.0).r;
+}
+
+void main() {
+  vec3 color = textureLod(inputTextures[0], texUv, 0.0).rgb;
+  float depth = textureLod(inputTextures[1], texUv, 0.0).r;
+
+  // WREN renders with an infinite projection and zero-to-one clip depth (Constants.hpp):
+  // window depth = 1 - near / d.
+  mat4 p = cameraTransforms.infiniteProjection;
+  float near = -p[3][2];
+  float viewDepth = depth >= 1.0 ? HORIZON : min(near / (1.0 - depth), HORIZON);
+  vec2 ndc = texUv * 2.0 - 1.0;
+  vec3 rayView = vec3(ndc.x / p[0][0], ndc.y / p[1][1], -1.0);
+  mat4 inverseView = inverse(cameraTransforms.view);
+  vec3 origin = inverseView[3].xyz;
+  vec3 ray = mat3(inverseView) * rayView;  // world, scaled so that one unit = one metre of view depth
+  float rayScale = length(ray);
+  vec3 direction = ray / rayScale;
+  float tEnd = viewDepth * rayScale;
+  float tStart = 0.0;
+
+  // The air past the box's sides, between them and distant land: the ray's length outside the
+  // box's footprint. None inside it, so the box's own view is untouched.
+  if (haze.x > 0.0 && depth < 1.0) {
+    vec2 near = (boxMin.xy - origin.xy) / direction.xy, far = (boxMax.xy - origin.xy) / direction.xy;
+    vec2 enter = min(near, far), leave = max(near, far);
+    float inside = max(min(min(leave.x, leave.y), tEnd) - max(max(enter.x, enter.y), 0.0), 0.0);
+    float outside = tEnd - inside;
+    if (outside > 0.0)
+      color = mix(color, horizonRadiance(direction, color), 1.0 - exp(-outside / haze.x));
+  }
+
+  if (boxMin.w > 0.0) {
+    vec3 inverseDirection = 1.0 / direction;
+    vec3 reach = 10.0 * vec3(boxMin.w, boxMin.w, max(boxMax.w, 0.0));  // where the falloff is below e^-10
+    vec3 t0 = (boxMin.xyz - reach - origin) * inverseDirection;
+    vec3 t1 = (boxMax.xyz + reach - origin) * inverseDirection;
+    vec3 tNear = min(t0, t1);
+    vec3 tFar = max(t0, t1);
+    tStart = max(max(tNear.x, tNear.y), max(tNear.z, 0.0));
+    tEnd = min(tEnd, min(min(tFar.x, tFar.y), tFar.z));
+  }
+
+  if (tEnd <= tStart) {
+    result = vec4(color, 1.0);
+    return;
+  }
+
+  vec3 sigma = scattering.rgb;  // scatter only: extinction equals scattering
+  float g = scattering.a;
+  vec3 phaseRadiance0 = sunDirection0.w * henyeyGreenstein(dot(direction, sunDirection0.xyz), g) * sunRadiance0.rgb;
+  vec3 phaseRadiance1 = sunDirection1.w * henyeyGreenstein(dot(direction, sunDirection1.xyz), g) * sunRadiance1.rgb;
+
+  // Near the viewer, steps sample the canopy's sun occlusion; farther, out to the horizon,
+  // a few unoccluded steps: haze thickens to the horizon instead of stopping at a distance.
+  float tNear = min(tEnd, max(tStart, MAX_DISTANCE * rayScale));
+  // A forward-scattering medium gets most of its sky light from straight ahead: the phase-weighted
+  // table (looking down, from the dark ground; towards the sunset, from its glow). Where the view
+  // ray ends on geometry, that geometry hides the sky ahead (a crown seen against the sunset stays
+  // a silhouette): no more than the sky's mean over all directions scatters.
+  vec3 skyIn = depth >= 1.0 ? ambientRadiance(direction) : min(ambientRadiance(direction), ambient.rgb);
+  // Steps grow with distance (quadratically): shafts near the viewer are resolved, far ones blend.
+  float offset = dither(gl_FragCoord.xy);
+  vec3 transmittance = vec3(1.0);
+  vec3 inScattered = vec3(0.0);
+  float previousT = tStart;
+  for (int i = 0; i < STEPS; ++i) {
+    float s = (float(i) + offset) / float(STEPS);
+    float t = tStart + (tNear - tStart) * s * s;
+    float next = tStart + (tNear - tStart) * pow((float(i) + 1.0) / float(STEPS), 2.0);
+    float stepLength = next - previousT;
+    previousT = next;
+    vec3 position = origin + direction * t;
+    vec3 source;
+    if (shadows.occlusionParams.x > 0.0) {  // sun 0 casts the shadow maps (B), sun 1 does not (G)
+      vec4 visible = bakedVisibility(position);
+      float mapped = shadowMapVisibility(position, visible.b);
+      // The second sun, 25 degrees from the first, shaded like it near the viewer (see pbr.frag).
+      source = skyIn * visible.r + phaseRadiance0 * mapped + phaseRadiance1 * min(visible.g, mapped / max(visible.b, 0.05) * visible.g);
+    } else
+      source = skyIn + phaseRadiance0 * sunVisibility(position, sunDirection0.xyz) +
+               phaseRadiance1 * sunVisibility(position, sunDirection1.xyz);
+    // Exact integral of a constant source over the step: (1 - T_step) * source.
+    vec3 stepTransmittance = exp(-sigma * density(position) * stepLength);
+    inScattered += transmittance * (1.0 - stepTransmittance) * source;
+    transmittance *= stepTransmittance;
+  }
+  float farStep = (tEnd - tNear) / float(FAR_STEPS);
+  vec3 farSource = horizonRadiance(direction, skyIn + phaseRadiance0 + phaseRadiance1);
+  for (int i = 0; i < FAR_STEPS && farStep > 0.0; ++i) {
+    vec3 stepTransmittance = exp(-sigma * density(origin + direction * (tNear + (float(i) + offset) * farStep)) * farStep);
+    inScattered += transmittance * (1.0 - stepTransmittance) * farSource;
+    transmittance *= stepTransmittance;
+  }
+
+  result = vec4(color * transmittance + inScattered, 1.0);
+}
