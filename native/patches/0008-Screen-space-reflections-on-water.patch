+  void Scene::copyOpaqueScene() {
+    FrameBuffer *frameBuffer = mCurrentViewport->frameBuffer();
+    if (!frameBuffer || !frameBuffer->glName() || frameBuffer->outputTextures().empty() || !frameBuffer->depthTexture()) {
+      // No copy for this viewport: unbind, so shaders find nothing rather than another view's scene.
+      for (int unit : {17, 18}) {
+        glstate::activateTextureUnit(unit);
+        glBindTexture(GL_TEXTURE_2D, 0);
+      }
+      return;
+    }
+    const int width = frameBuffer->width(), height = frameBuffer->height();
+    const unsigned int depthFormat = frameBuffer->depthTexture()->glFormatParams().mInternalFormat;
+    const unsigned int colorFormat = frameBuffer->outputTexture(0)->glFormatParams().mInternalFormat;
+    if (!mSceneCopyFrameBuffer || width != mSceneCopyWidth || height != mSceneCopyHeight ||
+        depthFormat != mSceneCopyDepthFormat) {
+      if (!mSceneCopyFrameBuffer) {
+        glGenFramebuffers(1, &mSceneCopyFrameBuffer);
+        glGenTextures(1, &mSceneCopyColor);
+        glGenTextures(1, &mSceneCopyDepth);
+      }
+      const auto &color = frameBuffer->outputTexture(0)->glFormatParams();
+      const auto &depth = frameBuffer->depthTexture()->glFormatParams();
+      glstate::activateTextureUnit(17);
+      glBindTexture(GL_TEXTURE_2D, mSceneCopyColor);
+      glTexImage2D(GL_TEXTURE_2D, 0, color.mInternalFormat, width, height, 0, color.mFormat, color.mDataType, NULL);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+      glstate::activateTextureUnit(18);
+      glBindTexture(GL_TEXTURE_2D, mSceneCopyDepth);
+      glTexImage2D(GL_TEXTURE_2D, 0, depth.mInternalFormat, width, height, 0, depth.mFormat, depth.mDataType, NULL);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+      const unsigned int drawFrameBuffer = glstate::boundDrawFrameBuffer();
+      glstate::bindDrawFrameBuffer(mSceneCopyFrameBuffer);
+      glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, mSceneCopyColor, 0);
+      glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER,
+                             depth.mInternalFormat == GL_DEPTH24_STENCIL8 ? GL_DEPTH_STENCIL_ATTACHMENT : GL_DEPTH_ATTACHMENT,
+                             GL_TEXTURE_2D, mSceneCopyDepth, 0);
+      glstate::bindDrawFrameBuffer(drawFrameBuffer);
+      mSceneCopyWidth = width;
+      mSceneCopyHeight = height;
+      mSceneCopyDepthFormat = depthFormat;
+      (void)colorFormat;
+    }
+    const unsigned int readFrameBuffer = glstate::boundReadFrameBuffer();
+    const unsigned int drawFrameBuffer = glstate::boundDrawFrameBuffer();
+    glstate::bindReadFrameBuffer(frameBuffer->glName());
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    glstate::bindDrawFrameBuffer(mSceneCopyFrameBuffer);
+    const unsigned int attachment = GL_COLOR_ATTACHMENT0;
+    glDrawBuffers(1, &attachment);
+    glBlitFramebuffer(0, 0, width, height, 0, 0, width, height, GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+    glstate::bindReadFrameBuffer(readFrameBuffer);
+    glstate::bindDrawFrameBuffer(drawFrameBuffer);
+    frameBuffer->bind();  // restores its draw buffers
+    glstate::activateTextureUnit(17);
+    glBindTexture(GL_TEXTURE_2D, mSceneCopyColor);
+    glstate::activateTextureUnit(18);
+    glBindTexture(GL_TEXTURE_2D, mSceneCopyDepth);
+  }
+
   void Scene::renderShadowMap() {
     if (mOcclusionTexture) {
       glstate::activateTextureUnit(16);
@@ -399,6 +471,11 @@ namespace wren {
 
   Scene::~Scene() {
     delete mShadowMap;
+    if (mSceneCopyFrameBuffer) {
