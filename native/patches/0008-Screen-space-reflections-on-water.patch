 // occlusion: the sky's visibility over the hemisphere (diffuse) and overhead. Specular reflections
 // look along one direction: the steeper up a smooth surface reflects, the more it sees what is
 // overhead (a river seen from above mirrors the open sky over it).
+// The image based reflection, as added to the color, and its weight (see screenSpaceReflection).
+vec3 iblReflection;
+vec3 iblReflectionWeight;
+
 vec3 getIBLContribution(PBRInfo pbrInputs, vec3 n, vec3 reflection, vec2 occlusion) {
   vec3 diffuseLight = vec3(0.0);
   vec3 specularLight = vec3(0.0);
@@ -359,6 +372,8 @@ vec3 getIBLContribution(PBRInfo pbrInputs, vec3 n, vec3 reflection, vec2 occlusi
   // scale ambient light contribution
   float specularOcclusion =
     mix(occlusion.x, occlusion.y, clamp(reflection.z, 0.0, 1.0) * (1.0 - pbrInputs.perceptualRoughness));
+  iblReflection = specularLight * specularOcclusion * material.backgroundColorAndIblStrength.w;
+  iblReflectionWeight = pbrInputs.specularColor * brdf.x + brdf.y;
   diffuse *= material.backgroundColorAndIblStrength.w * occlusion.x;
   specular *= material.backgroundColorAndIblStrength.w * specularOcclusion;
 
@@ -440,6 +455,67 @@ float impostorDepth() {
 
 #endif
 
+// Screen-space reflection off a smooth translucent surface (water): march the reflected ray in view
+// space against the opaque scene's depth; rgb: the scene's radiance where it hits, a: confidence
+// (0 on a miss, fading towards the screen's edges and for rays turning towards the camera).
+vec4 screenSpaceReflection(vec3 position, vec3 normal) {
+  vec2 size = vec2(textureSize(sceneDepth, 0));
+  if (size.x < 2.0)
+    return vec4(0.0);
+  mat4 p = cameraTransforms.infiniteProjection;
+  float near = -p[3][2];
+  vec3 direction = reflect(normalize(position), normal);
+  if (direction.z > 0.3)  // towards the camera: what it would hit is not on screen
+    return vec4(0.0);
+  float t = 0.05 * -position.z + 0.1;
+  float previous = 0.0;
+  // Where the ray first passed behind the scene too far to be a hit (under a crown, behind a
+  // trunk): the reflection is blocked there, not open to the sky the environment map shows.
+  vec2 blocked = vec2(-1.0);
+  for (int i = 0; i < 40; ++i) {
+    vec3 q = position + direction * t;
+    if (q.z > -near)
+      break;
+    vec4 clip = p * vec4(q, 1.0);
+    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
+    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
+      break;
+    float depth = texture(sceneDepth, uv).r;
+    float sceneZ = depth >= 1.0 ? 1e9 : near / (1.0 - depth);
+    float gap = -q.z - sceneZ;
+    if (gap > 0.0) {
+      // Behind the scene: a hit when the ray is not far behind it (else it passed under an object).
+      if (gap < 0.25 + 0.15 * (t - previous)) {
+        for (int k = 0; k < 5; ++k) {  // refine between the last two samples
+          float middle = 0.5 * (previous + t);
+          vec3 m = position + direction * middle;
+          vec4 mc = p * vec4(m, 1.0);
+          vec2 muv = mc.xy / mc.w * 0.5 + 0.5;
+          float md = texture(sceneDepth, muv).r;
+          if (-m.z > (md >= 1.0 ? 1e9 : near / (1.0 - md))) {
+            t = middle;
+            uv = muv;
+          } else
+            previous = middle;
+        }
+        vec2 edge = min(uv, 1.0 - uv);
+        float fade = clamp(min(edge.x, edge.y) * 10.0, 0.0, 1.0) * clamp((0.3 - direction.z) * 4.0, 0.0, 1.0);
+        return vec4(texture(sceneColor, uv).rgb, fade);
+      }
+      if (blocked.x < 0.0)
+        blocked = uv;
+    }
+    previous = t;
+    t *= 1.18;
+  }
+  if (blocked.x >= 0.0) {
+    vec2 edge = min(blocked, 1.0 - blocked);
+    float fade = clamp(min(edge.x, edge.y) * 10.0, 0.0, 1.0) * clamp((0.3 - direction.z) * 4.0, 0.0, 1.0);
+    return vec4(texture(sceneColor, blocked).rgb, 0.8 * fade);
+  }
+  return vec4(0.0);
+}
+
 void main() {
 #ifdef IMPOSTOR
   // Depth from the captured views: the texel's surface, for the depth buffer (so ambient
@@ -696,6 +772,9 @@ void main() {
 
   fragColor = vec4(color.rgb, baseColor.a);
   if (material.transmission.x > 0.0) {
+    // What the surface mirrors: the opaque scene where a screen-space ray finds it, the sky else.
+    vec4 mirrored = screenSpaceReflection(fragmentPosition, viewFragmentNormal);
+    color.rgb += mirrored.a * (mirrored.rgb - iblReflection) * iblReflectionWeight;
     // Premultiplied: reflection and foam are added; the scene behind shows through the
     // transmitted share left after Fresnel reflection (water IOR 1.333: F0 = 0.02).
     float fresnel = 0.02 + 0.98 * pow(1.0 - clamp(dot(viewFragmentNormal, normalize(-fragmentPosition)), 0.0, 1.0), 5.0);
