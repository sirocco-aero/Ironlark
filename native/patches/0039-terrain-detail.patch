+  vec2 u = (surfacePosition.xy - shadows.occlusionRect.xy) / size;
+  vec2 flip = vec2(1.0);
+  if (shadows.occlusionParams.w > 0.0) {
+    vec2 m = mod(u, 2.0);
+    flip = 1.0 - 2.0 * step(1.0, m);
+    u = 1.0 - abs(m - 1.0);
+  }
+  vec2 p = shadows.occlusionRect.xy + u * size - shadows.detailTiles[1].zw;
+  vec2 mask = texture(detailMask, u).rg;
+  // The source's blend: leaves under ground by 'path', both under the rocky trail by 'river'.
+  float weights[3] = float[3]((1.0 - mask.r) * (1.0 - mask.g), mask.r * (1.0 - mask.g), mask.g);
+  vec2 tiles[3] = vec2[3](shadows.detailTiles[0].xy, shadows.detailTiles[0].zw, shadows.detailTiles[1].xy);
+  vec3 color = vec3(0.0), coarse = vec3(0.0);
+  vec2 tangentSlope = vec2(0.0);  // height gradient: fine slopes minus those the bake already holds
+  roughness = 0.0;
+  for (int k = 0; k < 3; ++k) {
+    if (weights[k] <= 0.0)
+      continue;
+    vec3 uvw = vec3(p / tiles[k], float(k));
+    // The mip level whose texels match the bake's.
+    float lod = max(0.0, log2(shadows.detailParams.y * shadows.detailParams.z / tiles[k].x));
+    color += weights[k] * texture(detailColor, uvw).rgb;
+    coarse += weights[k] * textureLod(detailColor, uvw, lod).rgb;
+    vec3 fine = texture(detailNormal, uvw).rgb * 2.0 - 1.0;
+    vec3 blurred = textureLod(detailNormal, uvw, lod).rgb * 2.0 - 1.0;
+    tangentSlope += weights[k] * (fine.xy / max(fine.z, 0.1) - blurred.xy / max(blurred.z, 0.1));
+    roughness += weights[k] * texture(detailRoughness, uvw).r;
