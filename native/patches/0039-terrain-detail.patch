+
+// Terrain detail layers: terrainDetailUrl holds the color, normal and roughness images, each three
+// square layers stacked; terrainDetailMaskUrl the layers' blend weights (R, G) over the light
+// occlusion rectangle, mirrored as it is; terrainDetailTiles each layer's tile size, the tiling
+// origin, then the texel size of the material's own (baked) maps in x, in metres.
+void WbBackground::updateTerrainDetail() {
+  WbWrenOpenGlContext::makeWrenCurrent();
+  QList<QByteArray> layers;
+  int size = 0;
+  QImage mask;
+  bool valid = mTerrainDetailUrl->size() == 3 && mTerrainDetailMaskUrl->size() == 1 && mTerrainDetailTiles->size() == 5;
+  for (int k = 0; valid && k < 3; ++k) {
+    const QString path = WbUrl::computePath(this, "terrainDetailUrl", mTerrainDetailUrl->item(k), true);
+    QImage image;
+    if (!image.load(path) || image.height() != 3 * image.width() || (size && image.width() != size)) {
+      warn(tr("Terrain detail image '%1' must stack three square layers of one size.").arg(path));
+      valid = false;
+      break;
+    }
+    size = image.width();
+    image = image.convertToFormat(QImage::Format_RGBA8888);
+    QByteArray data;
+    for (int layer = 0; layer < 3; ++layer) {  // rows from v = 0, as Blender samples images
+      const QImage part = image.copy(0, layer * size, size, size).mirrored(false, true);
+      data.append(reinterpret_cast<const char *>(part.constBits()), part.sizeInBytes());
+    }
+    layers.append(data);
+  }
+  if (valid) {
+    const QString path = WbUrl::computePath(this, "terrainDetailMaskUrl", mTerrainDetailMaskUrl->item(0), true);
+    if (!mask.load(path)) {
+      warn(tr("Cannot load terrain detail mask '%1'.").arg(path));
+      valid = false;
+    } else
+      mask = mask.convertToFormat(QImage::Format_RGBA8888).mirrored(false, true);  // rows from min y
+  }
+  if (!valid) {
+    wr_scene_set_terrain_detail(wr_scene_get_instance(), NULL, NULL, NULL, 0, NULL, 0, 0, NULL);
+    WbWrenOpenGlContext::doneWren();
+    return;
+  }
+  float tiles[10];
+  for (int k = 0; k < 5; ++k) {
+    tiles[2 * k] = mTerrainDetailTiles->item(k).x();
+    tiles[2 * k + 1] = mTerrainDetailTiles->item(k).y();
+  }
+  wr_scene_set_terrain_detail(wr_scene_get_instance(), reinterpret_cast<const unsigned char *>(layers[0].constData()),
+                              reinterpret_cast<const unsigned char *>(layers[1].constData()),
+                              reinterpret_cast<const unsigned char *>(layers[2].constData()), size, mask.constBits(),
+                              mask.width(), mask.height(), tiles);
+  WbWrenOpenGlContext::doneWren();
 }
 
