+
+void WbBackground::updateLightOcclusion() {
+  WbWrenOpenGlContext::makeWrenCurrent();
+  const int layers = mLightOcclusionHeights->size();
+  QImage image;
+  if (mLightOcclusionUrl->size() > 0 && layers > 0 && layers <= 8) {
+    const QString path = WbUrl::computePath(this, "lightOcclusionUrl", mLightOcclusionUrl->item(0), true);
+    if (!image.load(path))
+      warn(tr("Cannot load light occlusion image '%1'.").arg(path));
+    else if (image.height() % (layers + 1))
+      warn(tr("The light occlusion image must stack %1 layers and a ground layer of equal height.").arg(layers));
+  } else if (layers > 8)
+    warn(tr("At most 8 light occlusion layers are supported."));
+  if (image.isNull() || image.height() % (layers + 1)) {
+    wr_scene_set_light_occlusion(wr_scene_get_instance(), NULL, 0, 0, 0, NULL, 0.0f, 0.0f, NULL, false);
+    WbWrenOpenGlContext::doneWren();
+    return;
+  }
+  // WREN takes each layer with rows from min y: flip each layer, keeping their order.
+  image = image.convertToFormat(QImage::Format_RGBA8888);
+  const int height = image.height() / (layers + 1);
+  QByteArray data;
+  for (int k = 0; k <= layers; ++k) {
+    const QImage layer = image.copy(0, k * height, image.width(), height).mirrored(false, true);
+    data.append(reinterpret_cast<const char *>(layer.constBits()), layer.sizeInBytes());
+  }
+  const float rect[4] = {static_cast<float>(mLightOcclusionMin->x()), static_cast<float>(mLightOcclusionMin->y()),
+                         static_cast<float>(mLightOcclusionMax->x()), static_cast<float>(mLightOcclusionMax->y())};
+  float heights[8];
+  for (int k = 0; k < layers; ++k)
+    heights[k] = mLightOcclusionHeights->item(k);
+  wr_scene_set_light_occlusion(wr_scene_get_instance(), reinterpret_cast<const unsigned char *>(data.constData()),
+                               image.width(), height, layers, rect, mLightOcclusionGround->x(), mLightOcclusionGround->y(),
+                               heights, mLightOcclusionMirrored->value());
+  WbWrenOpenGlContext::doneWren();
 }
 
