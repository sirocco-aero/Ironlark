+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef PROFILER_HPP
+#define PROFILER_HPP
+
+namespace wren {
+  // With IRONLARK_FRAME_LOG set to a file, each rendered view writes one line: the CPU and GPU time of each of its
+  // passes (GPU from timestamp queries, read back frames later so the log never stalls the pipeline). Other lines
+  // (frames presented, physics steps) come from Webots through write(). Times are CLOCK_MONOTONIC.
+  namespace profiler {
+    bool enabled();
+    long long now();  // nanoseconds
+    void beginFrame(const char *label);
+    void mark(const char *pass);
+    void count(long long triangles, long long instances);  // drawn in this frame
+    void endFrame();
+    // With IRONLARK_FRAME_LOG_DRAWS=1 as well, each draw is a pass of its own (diagnostics only:
+    // the queries between draws cost time).
+    bool drawsEnabled();
+    void write(const char *line);
+  }  // namespace profiler
+}  // namespace wren
+
+#endif  // PROFILER_HPP
