diff --git a/src/wren/Profiler.cpp b/src/wren/Profiler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cdc5f458a0cbc536c69982ed2f229f04d0d25b3e
--- /dev/null
+++ b/src/wren/Profiler.cpp
@@ -0,0 +1,168 @@
+// Copyright 1996-2024 Cyberbotics Ltd.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     https://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "Profiler.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <string>
+#include <vector>
+
+#ifdef __EMSCRIPTEN__
+#include <GLES3/gl3.h>
+#else
+#include <glad/glad.h>
+#endif
+
+namespace wren {
+  namespace profiler {
+    namespace {
+      const int FRAMES = 16;
+
+      struct Frame {
+        bool pending = false;
+        std::string label;
+        std::vector<std::string> names;
+        std::vector<long long> cpu;
+        std::vector<unsigned int> queries;
+        long long triangles = 0;
+        long long instances = 0;
+      };
+
+      FILE *gFile = NULL;
+      int gState = -1;  // unknown, off, on
+      bool gDraws = false;
+      Frame gFrames[FRAMES];
+      int gCurrent = -1;
+      int gNext = 0;
+      long long gLastFlush = 0;
+
+      void flush() {
+        const long long t = now();
+        if (t - gLastFlush > 500000000LL) {
+          fflush(gFile);
+          gLastFlush = t;
+        }
+      }
+
+      // Write the frames whose queries are done (all of them if wait).
+      void collect(bool wait) {
+#ifndef __EMSCRIPTEN__
+        for (int k = 1; k <= FRAMES; ++k) {
+          Frame &f = gFrames[(gNext + k) % FRAMES];
+          if (!f.pending)
+            continue;
+          const size_t count = f.names.size();
+          GLint available = 0;
+          glGetQueryObjectiv(f.queries[count - 1], GL_QUERY_RESULT_AVAILABLE, &available);
+          if (!available && !wait)
+            continue;
+          std::vector<GLuint64> gpu(count);
+          for (size_t i = 0; i < count; ++i)
+            glGetQueryObjectui64v(f.queries[i], GL_QUERY_RESULT, &gpu[i]);
+          fprintf(gFile, "G %s %lld cpu %.1f gpu %.1f", f.label.c_str(), f.cpu[0], (f.cpu[count - 1] - f.cpu[0]) / 1000.0,
+                  (gpu[count - 1] - gpu[0]) / 1000.0);
+          for (size_t i = 1; i < count; ++i)
+            fprintf(gFile, " %s %.1f %.1f", f.names[i].c_str(), (f.cpu[i] - f.cpu[i - 1]) / 1000.0,
+                    (gpu[i] - gpu[i - 1]) / 1000.0);
+          fprintf(gFile, " triangles %lld 0 instances %lld 0\n", f.triangles, f.instances);
+          f.pending = false;
+        }
+#endif
+      }
+    }  // namespace
+
+    bool enabled() {
+      if (gState < 0) {
+        const char *path = getenv("IRONLARK_FRAME_LOG");
+        gFile = path && *path ? fopen(path, "a") : NULL;
+        gState = gFile ? 1 : 0;
+        if (gFile)
+          setvbuf(gFile, NULL, _IOFBF, 1 << 16);
+        const char *draws = getenv("IRONLARK_FRAME_LOG_DRAWS");
+        gDraws = gFile && draws && *draws && strcmp(draws, "0");
+      }
+      return gState == 1;
+    }
+
+    bool drawsEnabled() {
+      return enabled() && gDraws && gCurrent >= 0;
+    }
+
+    long long now() {
+      timespec t;
+      clock_gettime(CLOCK_MONOTONIC, &t);
+      return t.tv_sec * 1000000000LL + t.tv_nsec;
+    }
+
+    void beginFrame(const char *label) {
+      if (!enabled() || gCurrent >= 0)
+        return;
+      collect(false);
+      Frame &f = gFrames[gNext];
+      if (f.pending)
+        collect(true);
+      gCurrent = gNext;
+      gNext = (gNext + 1) % FRAMES;
+      f.names.clear();
+      f.cpu.clear();
+      f.label = label;
+      f.triangles = 0;
+      f.instances = 0;
+      mark("begin");
+    }
+
+    void mark(const char *pass) {
+      if (gCurrent < 0)
+        return;
+      Frame &f = gFrames[gCurrent];
+      const size_t i = f.names.size();
+      if (i == f.queries.size()) {
+        f.queries.resize(i + 32);
+        glGenQueries(32, &f.queries[i]);
+      }
+      f.names.push_back(pass);
+      f.cpu.push_back(now());
+#ifndef __EMSCRIPTEN__
+      glQueryCounter(f.queries[i], GL_TIMESTAMP);
+#endif
+    }
+
+    void count(long long triangles, long long instances) {
+      if (gCurrent < 0)
+        return;
+      gFrames[gCurrent].triangles += triangles;
+      gFrames[gCurrent].instances += instances;
+    }
+
+    void endFrame() {
+      if (gCurrent < 0)
+        return;
+      mark("end");
+      gFrames[gCurrent].pending = true;
+      gCurrent = -1;
+      flush();
+    }
+
+    void write(const char *line) {
+      if (!enabled())
+        return;
+      fputs(line, gFile);
+      fputc('\n', gFile);
+      flush();
+    }
+  }  // namespace profiler
+}  // namespace wren
