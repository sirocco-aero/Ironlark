+void WbWrenScatteringFog::loadCloud(const QString &path) {
+  WbWrenOpenGlContext::makeWrenCurrent();
+  const QString key = "cloud:" + path;
+  WrTexture2d *texture = sharedTexture(key);
+  if (!texture) {
+    QImage image;
+    if (!path.isEmpty())
+      image.load(path);
+    image = image.isNull() ? QImage(1, 1, QImage::Format_Grayscale16) : image.convertToFormat(QImage::Format_Grayscale16);
+    if (path.isEmpty() || image.isNull())
+      image.fill(0);
+    std::vector<qfloat16> heights(static_cast<size_t>(image.width()) * image.height());
