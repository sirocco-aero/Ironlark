+// Input textures by what they hold (kind and path), shared by every view's fog (main view, Camera
+// devices): one copy of each map in GPU memory.
+namespace {
+  struct SharedTexture {
+    WrTexture2d *texture;
+    int users;
+  };
+  QHash<QString, SharedTexture> gSharedTextures;
+
+  WrTexture2d *sharedTexture(const QString &key) {
+    auto it = gSharedTextures.find(key);
+    if (it == gSharedTextures.end())
+      return NULL;
+    ++it->users;
+    return it->texture;
+  }
+
+  void shareTexture(const QString &key, WrTexture2d *texture) {
+    gSharedTextures.insert(key, {texture, 1});
+  }
+
+  void releaseTexture(WrTexture2d *texture) {
+    if (!texture)
+      return;
+    for (auto it = gSharedTextures.begin(); it != gSharedTextures.end(); ++it) {
+      if (it->texture == texture) {
+        if (--it->users == 0) {
+          wr_texture_delete(WR_TEXTURE(texture));
+          gSharedTextures.erase(it);
+        }
+        return;
+      }
+    }
+  }
+}  // namespace
