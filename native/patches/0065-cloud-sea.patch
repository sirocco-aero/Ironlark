+// The sea of cloud, as an inversion's cloud tops seen from above: the tops' map (puffs on puffs)
+// over broad swells (the same map, larger, turned and blurred, which also hides its repeat), lit
+// by the suns and the sky, shadowed by one another, fading to the horizon's sky with distance.
+const vec3 CLOUD_ALBEDO = vec3(0.8);
+const float CLOUD_SWELL = 16.0;       // metres between the swells' lowest and highest
+const float CLOUD_SWELL_SCALE = 6.3;  // the swells' map, this much larger
+const float CLOUD_HAZE = 2000.0;      // distance over which the tops take the horizon's colour
+const mat2 CLOUD_TURN = mat2(0.8, 0.6, -0.6, 0.8);
+
+// Height of the tops at p; footprint: metres per pixel there, choosing the map's level of detail.
+float cloudTopHeight(vec2 p, float footprint) {
+  float lod = log2(max(footprint * float(textureSize(inputTextures[3], 0).x) / cloud.z, 1.0));
+  float fine = textureLod(inputTextures[3], p / cloud.z, lod).r;
+  float swell = textureLod(inputTextures[3], CLOUD_TURN * p / (cloud.z * CLOUD_SWELL_SCALE) + vec2(0.37, 0.71),
+                           max(lod - log2(CLOUD_SWELL_SCALE), 3.5)).r;
+  return mix(cloud.x, cloud.y, fine) + CLOUD_SWELL * (swell - 0.5);
+}
+
+float cloudGap(vec3 p, float footprint) {
+  return p.z - cloudTopHeight(p.xy, footprint);
+}
+
+// Distance along the ray to the cloud tops, or -1 when geometry (at tLimit) or nothing comes first.
+// Steps are as long as the tops' steepest slope allows without passing through them (long high
+// above, short close by), then two secant steps refine the crossing.
+float cloudHit(vec3 origin, vec3 direction, float tLimit, float pixelAngle, float offset) {
+  float low = cloud.x - 0.5 * CLOUD_SWELL, high = cloud.y + 0.5 * CLOUD_SWELL;
+  if (cloudSky.w <= 0.0 || direction.z > -1e-4 || origin.z <= low)
+    return -1.0;
+  float t0 = max((origin.z - high) / -direction.z, 0.0);
+  float t1 = (origin.z - low) / -direction.z;
+  if (t0 >= tLimit)
+    return -1.0;
+  const int STEPS_CLOUD = 32;
+  const float SLOPE = 1.2;  // the tops' steepest rise per metre
+  float rate = -direction.z + SLOPE * length(direction.xy);  // how fast the gap can close per metre
+  float t = t0, gap = cloudGap(origin + direction * t, t * pixelAngle);
+  float previousT = t, previousGap = gap;
+  for (int i = 0; i < STEPS_CLOUD && gap > 0.0; ++i) {
+    previousT = t;
+    previousGap = gap;
+    t = min(t + max(gap / rate, 0.002 * t) * (i == 0 ? 0.5 + offset : 1.0), t1);
+    gap = cloudGap(origin + direction * t, t * pixelAngle);
+    if (t >= tLimit && gap > 0.0)
+      return -1.0;
+  }
+  if (gap > 0.0)
+    return t < tLimit ? t : -1.0;  // ran out of steps just above the tops
+  float a = previousT, ga = previousGap, b = t, gb = gap;
+  for (int k = 0; k < 2; ++k) {
+    float m = a + (b - a) * ga / max(ga - gb, 1e-4);
+    float gm = cloudGap(origin + direction * m, m * pixelAngle);
+    if (gm > 0.0) {
+      a = m;
+      ga = gm;
+    } else {
+      b = m;
+      gb = gm;
+    }
+  }
+  float hit = a + (b - a) * ga / max(ga - gb, 1e-4);
+  return hit < tLimit ? hit : -1.0;
+}
+
+vec3 cloudRadiance(vec3 p, vec3 direction, float footprint) {
+  // The tops' slope across a pixel (or a metre, near).
+  float e = max(footprint, 1.0);
+  float h = cloudTopHeight(p.xy, footprint);
+  vec3 normal = normalize(vec3(h - cloudTopHeight(p.xy + vec2(e, 0.0), footprint), h - cloudTopHeight(p.xy + vec2(0.0, e), footprint), e));
+  // Sunlight past the billows upsun: the sun ray's height over the tops at a few distances, soft.
+  vec3 toSun = sunDirection0.xyz;
+  float shade = 1.0;
+  for (int k = 0; k < 3; ++k) {
+    float s = 6.0 * pow(3.2, float(k));
+    shade = min(shade, clamp(0.5 + cloudGap(p + toSun * s, footprint) / (0.15 * s + 0.5), 0.0, 1.0));
+  }
+  float sunLit = shade * shadowMapVisibility(p, 1.0);
+  float diffuse0 = clamp((dot(normal, toSun) + 0.05) / 1.05, 0.0, 1.0);
+  float diffuse1 = clamp((dot(normal, sunDirection1.xyz) + 0.05) / 1.05, 0.0, 1.0);
+  vec3 sun = (sunDirection0.w * sunRadiance0.rgb * diffuse0 + sunDirection1.w * sunRadiance1.rgb * diffuse1) * sunLit / PI;
+  // Sky light, less in the creases (below the tops around them), which see less of the sky.
+  float around = cloudTopHeight(p.xy, max(footprint, 16.0 * cloud.z / float(textureSize(inputTextures[3], 0).x)));
+  float open = clamp(0.55 + (h - around) / (0.2 * (cloud.y - cloud.x)), 0.15, 1.0);
+  vec3 sky = cloudSky.rgb * (0.4 + 0.6 * normal.z) * open;
+  // Light through the billows' edges, looking towards the sun.
+  float edge = 1.0 - clamp(dot(normal, -direction), 0.0, 1.0);
+  vec3 through = sunDirection0.w * sunRadiance0.rgb * henyeyGreenstein(dot(direction, toSun), 0.6) * sunLit * edge * edge * edge;
+  return CLOUD_ALBEDO * (sun + sky + through);
+}
