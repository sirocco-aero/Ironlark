+      const quint16 *row = reinterpret_cast<const quint16 *>(image.constScanLine(y));
+      for (int x = 0; x < image.width(); ++x)
+        heights[static_cast<size_t>(y) * image.width() + x] = qfloat16(row[x] / 65535.0f);
+    }
+    texture = wr_texture_2d_new();
+    wr_texture_set_internal_format(WR_TEXTURE(texture), WR_TEXTURE_INTERNAL_FORMAT_R16F);
+    wr_texture_set_size(WR_TEXTURE(texture), image.width(), image.height());
+    wr_texture_2d_set_data(texture, reinterpret_cast<const char *>(heights.data()));
