+#include "Occlusion.hpp"
+
+#include "Camera.hpp"
+#include "FrameBuffer.hpp"
+#include "GlState.hpp"
+#include "TextureRtt.hpp"
+#include "Viewport.hpp"
+
+#ifdef __EMSCRIPTEN__
+#include <GLES3/gl3.h>
+#else
+#include <glad/glad.h>
+#endif
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+namespace wren {
+
+  Occlusion::Phase Occlusion::cPhase = Occlusion::OFF;
+  const Occlusion *Occlusion::cCurrent = NULL;
+  long long Occlusion::cCulledTriangles = 0;
+
+  namespace {
+    // Culling pays when it hides more triangles than the GPU draws while the CPU waits and tests (a few ms).
+    const long long MIN_CULLED_TRIANGLES = 10000000;
+    const int RETRY_FRAMES = 30;
+  }  // namespace
+
+  namespace {
+    // The depth buffer's maximum over each 2x2 block (clamped at the edges): the pyramid's first level.
+    const char *VERTEX_SHADER = "#version 330 core\n"
+                                "void main() {\n"
+                                "  vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+                                "  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+                                "}\n";
+    const char *FRAGMENT_SHADER = "#version 330 core\n"
+                                  "uniform sampler2D depth;\n"
+                                  "layout(location = 0) out float result;\n"
+                                  "void main() {\n"
+                                  "  ivec2 last = textureSize(depth, 0) - 1;\n"
+                                  "  ivec2 p = ivec2(gl_FragCoord.xy) * 2;\n"
+                                  "  result = max(max(texelFetch(depth, min(p, last), 0).r,\n"
+                                  "                   texelFetch(depth, min(p + ivec2(1, 0), last), 0).r),\n"
+                                  "               max(texelFetch(depth, min(p + ivec2(0, 1), last), 0).r,\n"
+                                  "                   texelFetch(depth, min(p + ivec2(1, 1), last), 0).r));\n"
+                                  "}\n";
+    unsigned int gProgram = 0;
+    unsigned int gVertexArray = 0;
+
+    unsigned int compile(unsigned int type, const char *source) {
+      const unsigned int shader = glCreateShader(type);
+      glShaderSource(shader, 1, &source, NULL);
+      glCompileShader(shader);
+      return shader;
+    }
+
+    bool setupProgram() {
+      if (gProgram)
+        return true;
+      const unsigned int vertex = compile(GL_VERTEX_SHADER, VERTEX_SHADER);
+      const unsigned int fragment = compile(GL_FRAGMENT_SHADER, FRAGMENT_SHADER);
+      gProgram = glCreateProgram();
+      glAttachShader(gProgram, vertex);
+      glAttachShader(gProgram, fragment);
+      glLinkProgram(gProgram);
+      glDeleteShader(vertex);
+      glDeleteShader(fragment);
+      GLint linked = 0;
+      glGetProgramiv(gProgram, GL_LINK_STATUS, &linked);
+      if (!linked) {
+        glDeleteProgram(gProgram);
+        gProgram = 0;
+        return false;
+      }
+      glGenVertexArrays(1, &gVertexArray);
+      return true;
+    }
+  }  // namespace
+
+  bool Occlusion::isEnabled() {
+    static const bool enabled = [] {
+      const char *value = getenv("IRONLARK_OCCLUSION");
+      return !value || strcmp(value, "0");
+    }();
+    return enabled;
+  }
+
+  void Occlusion::startFrame() {
+    if (mSkipFrames > 0)
+      --mSkipFrames;
+    cCulledTriangles = 0;
+  }
+
+  void Occlusion::endFrame() {
+    ++mFrame;
+    if (cCulledTriangles < MIN_CULLED_TRIANGLES)
+      mSkipFrames = RETRY_FRAMES;
+  }
+
+  Occlusion::Occlusion() :
+    mFrame(0),
+    mSkipFrames(0),
+    mFrameBuffer(0),
+    mTexture(0),
+    mWidth(0),
+    mHeight(0),
+    mScaleX(0.0f),
+    mScaleY(0.0f),
+    mOffsetX(0.0f),
+    mOffsetY(0.0f),
+    mNear(0.0f) {
+  }
+
+  Occlusion::~Occlusion() {
+    if (mFrameBuffer)
+      glDeleteFramebuffers(1, &mFrameBuffer);
+    if (mTexture)
+      glDeleteTextures(1, &mTexture);
+  }
+
+  bool Occlusion::build(const Viewport *viewport) {
+#ifdef __EMSCRIPTEN__
+    return false;
+#else
+    const FrameBuffer *frameBuffer = viewport->frameBuffer();
+    const Camera *camera = viewport->camera();
+    if (!frameBuffer || !frameBuffer->depthTexture() || !frameBuffer->depthTexture()->glName() ||
+        camera->projectionMode() != WR_CAMERA_PROJECTION_MODE_PERSPECTIVE || FrameBuffer::isMultisampling() ||
+        !GLAD_GL_ARB_clip_control || !setupProgram())
+      return false;
+
+    const int width = frameBuffer->width(), height = frameBuffer->height();
+    const int halfWidth = (width + 1) / 2, halfHeight = (height + 1) / 2;
+    if (width != mWidth || height != mHeight) {
+      if (!mFrameBuffer) {
+        glGenFramebuffers(1, &mFrameBuffer);
+        glGenTextures(1, &mTexture);
+      }
+      glstate::activateTextureUnit(0);
+      glstate::bindTexture(mTexture, 0);
+      glTexImage2D(GL_TEXTURE_2D, 0, GL_R32F, halfWidth, halfHeight, 0, GL_RED, GL_FLOAT, NULL);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      glstate::bindTexture(0, 0);
+      glstate::bindFrameBuffer(mFrameBuffer);
+      glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, mTexture, 0);
+      mWidth = width;
+      mHeight = height;
+    }
+
+    // The first level on the GPU: a quarter of the pixels to read back.
+    const unsigned int previousProgram = glstate::activeProgram();
+    glstate::bindFrameBuffer(mFrameBuffer);
+    const unsigned int attachment = GL_COLOR_ATTACHMENT0;
+    glDrawBuffers(1, &attachment);
+    glViewport(0, 0, halfWidth, halfHeight);
+    glstate::setDepthTest(false);
+    glstate::setDepthMask(false);
+    glstate::setStencilTest(false);
+    glstate::setBlend(false);
+    glstate::setCullFace(false);
+    glstate::setColorMask(true, true, true, true);
+    glstate::bindProgram(gProgram);
+    glstate::activateTextureUnit(0);
+    glstate::bindTexture(frameBuffer->depthTexture()->glName(), 0);
+    glUniform1i(glGetUniformLocation(gProgram, "depth"), 0);
+    glstate::bindVertexArrayObject(gVertexArray);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+
+    if (mLevelWidths.empty() || mLevelWidths[0] != halfWidth || mLevelHeights[0] != halfHeight) {
+      mLevels.clear();
+      mLevelWidths.clear();
+      mLevelHeights.clear();
+      for (int w = halfWidth, h = halfHeight;; w = (w + 1) / 2, h = (h + 1) / 2) {
+        mLevels.emplace_back(static_cast<size_t>(w) * h);
+        mLevelWidths.push_back(w);
+        mLevelHeights.push_back(h);
+        if (w == 1 && h == 1)
+          break;
+      }
+    }
+    glstate::bindReadFrameBuffer(mFrameBuffer);
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    glstate::bindPixelPackBuffer(0);
+    glReadPixels(0, 0, halfWidth, halfHeight, GL_RED, GL_FLOAT, mLevels[0].data());
+
+    // Coarser levels on the CPU, each texel the maximum of the (up to) 2x2 below it.
+    for (size_t k = 1; k < mLevels.size(); ++k) {
+      const float *below = mLevels[k - 1].data();
+      float *level = mLevels[k].data();
+      const int w = mLevelWidths[k - 1], h = mLevelHeights[k - 1];
+      const int nw = mLevelWidths[k], nh = mLevelHeights[k];
+      for (int y = 0; y < nh; ++y) {
+        const float *row0 = below + static_cast<size_t>(2 * y) * w;
+        const float *row1 = below + static_cast<size_t>(std::min(2 * y + 1, h - 1)) * w;
+        for (int x = 0; x < nw; ++x) {
+          const int x1 = std::min(2 * x + 1, w - 1);
+          level[static_cast<size_t>(y) * nw + x] = std::max(std::max(row0[2 * x], row0[x1]), std::max(row1[2 * x], row1[x1]));
+        }
+      }
+    }
+
+    // Restore what WREN expects bound: the viewport's framebuffer and program.
+    viewport->bind();
+    glstate::bindProgram(previousProgram);
+
+    // Projection used to place spheres: the unjittered one (a pixel of margin covers the jitter).
+    mView = camera->view();
+    const glm::mat4 projection = camera->unjitteredViewProjection() * glm::inverse(mView);
+    mScaleX = 0.5f * width * projection[0][0];
+    mScaleY = 0.5f * height * projection[1][1];
+    mOffsetX = 0.5f * width;
+    mOffsetY = 0.5f * height;
+    mNear = camera->nearDistance();
+    return true;
+#endif
+  }
+
+  bool Occlusion::isOccluded(const glm::vec3 &center, float radius) const {
+    // View space, z towards the scene.
+    const glm::vec4 v = mView * glm::vec4(center, 1.0f);
+    const float cx = v.x, cy = v.y, cz = -v.z;
+    if (cz - radius <= mNear)
+      return false;  // reaches the near plane
+
+    // Screen bounds of the sphere's projection (tangent planes, exact for a symmetric perspective).
+    const float czr2 = cz * cz - radius * radius;
+    const float vx = std::sqrt(cx * cx + czr2), vy = std::sqrt(cy * cy + czr2);
+    const float x0 = (vx * cx - cz * radius) / (vx * cz + cx * radius), x1 = (vx * cx + cz * radius) / (vx * cz - cx * radius);
+    const float y0 = (vy * cy - cz * radius) / (vy * cz + cy * radius), y1 = (vy * cy + cz * radius) / (vy * cz - cy * radius);
+    // Pixels, a pixel of margin for the sub-pixel jitter and rounding.
+    float px0 = mOffsetX + mScaleX * x0, px1 = mOffsetX + mScaleX * x1;
+    float py0 = mOffsetY + mScaleY * y0, py1 = mOffsetY + mScaleY * y1;
+    if (px0 > px1)
+      std::swap(px0, px1);
+    if (py0 > py1)
+      std::swap(py0, py1);
+    px0 -= 1.0f;
+    py0 -= 1.0f;
+    px1 += 1.0f;
+    py1 += 1.0f;
+    if (px1 < 0.0f || py1 < 0.0f || px0 >= mWidth || py0 >= mHeight)
+      return false;  // off screen: left to the frustum test
+    const int ix0 = std::max(0, static_cast<int>(std::floor(px0))), iy0 = std::max(0, static_cast<int>(std::floor(py0)));
+    const int ix1 = std::min(mWidth - 1, static_cast<int>(std::floor(px1))),
+              iy1 = std::min(mHeight - 1, static_cast<int>(std::floor(py1)));
+
+    // The nearest depth the sphere can have, as the depth buffer stores it (infinite projection, zero-to-one clip
+    // depth: 1 - near / distance).
+    const float nearest = 1.0f - mNear / (cz - radius);
+
+    // The level where the bounds span at most four texels a side.
+    size_t level = 0;
+    int scale = 2;  // pixels per texel a side
+    while (level + 1 < mLevels.size() && (ix1 / scale - ix0 / scale >= 4 || iy1 / scale - iy0 / scale >= 4)) {
+      ++level;
+      scale *= 2;
+    }
+    const std::vector<float> &texels = mLevels[level];
+    const int w = mLevelWidths[level];
+    for (int y = iy0 / scale; y <= iy1 / scale; ++y)
+      for (int x = ix0 / scale; x <= ix1 / scale; ++x)
+        if (texels[static_cast<size_t>(y) * w + x] >= nearest - 1e-6f)
+          return false;
+    return true;
+  }
+
+}  // namespace wren
