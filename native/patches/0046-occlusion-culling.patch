+#ifndef OCCLUSION_HPP
+#define OCCLUSION_HPP
+
+#include "Constants.hpp"
+
+#include <vector>
+
+namespace wren {
+
+  class Viewport;
+
+  // Occlusion culling of instances, in two phases per view. The view first draws what it saw last frame; a
+  // max-depth pyramid of that depth is read back; then it draws the other instances unless their bounding sphere
+  // lies wholly behind the pyramid. What is culled is hidden by geometry already drawn: the image is unchanged.
+  class Occlusion {
+  public:
+    enum Phase { OFF, FIRST, SECOND };
+
+    // IRONLARK_OCCLUSION=0 turns it off (comparisons).
+    static bool isEnabled();
+    static Phase phase() { return cPhase; }
+    static void setPhase(Phase phase) { cPhase = phase; }
+    // The pyramid of the view drawing its second phase, or NULL (then nothing is culled).
+    static const Occlusion *current() { return cCurrent; }
+    static void setCurrent(const Occlusion *occlusion) { cCurrent = occlusion; }
+
+    Occlusion();
+    ~Occlusion();
+
+    // Build the pyramid from the viewport's depth as drawn so far and read it to the CPU (waits for the GPU).
+    bool build(const Viewport *viewport);
+    // Whether a world-space sphere is wholly behind what the pyramid holds.
+    bool isOccluded(const glm::vec3 &center, float radius) const;
+
+    // Whether this view culls this frame: a view whose last culling frame hid too little to pay for the wait on
+    // the first phase draws in one phase, and tries again some frames later.
+    bool isActive() const { return mSkipFrames == 0; }
+    void startFrame();
+    void endFrame();
+    // Frames culled so far: seen instances are retested in turn, a quarter of them each frame.
+    unsigned int frame() const { return mFrame; }
+    static void countCulled(long long triangles) { cCulledTriangles += triangles; }
+
+  private:
+    static Phase cPhase;
+    static const Occlusion *cCurrent;
+    static long long cCulledTriangles;
+
+    unsigned int mFrame;
+    int mSkipFrames;
+
+    unsigned int mFrameBuffer;
+    unsigned int mTexture;
+    int mWidth, mHeight;  // of the depth buffer
+    // Levels of the pyramid on the CPU: level k's texel covers 2^(k+1) pixels a side (level 0 is half resolution).
+    std::vector<std::vector<float>> mLevels;
+    std::vector<int> mLevelWidths, mLevelHeights;
+    glm::mat4 mView;
+    float mScaleX, mScaleY, mOffsetX, mOffsetY;  // view-space x/z, y/z to pixels (unjittered)
+    float mNear;
+  };
+
+}  // namespace wren
+
+#endif  // OCCLUSION_HPP
