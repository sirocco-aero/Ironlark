diff --git a/resources/wren/shaders/pbr.frag b/resources/wren/shaders/pbr.frag
index b3b4bef..e29fdb0 100644
--- a/resources/wren/shaders/pbr.frag
+++ b/resources/wren/shaders/pbr.frag
@@ -397,12 +397,11 @@ vec3 PBRpass(vec3 l, vec3 n, vec3 v, vec3 h, vec4 lightColorAndIntensity, float
   // diffuse light scale with intensity squared.
   vec3 diffuseContrib = (1.0 - F) * diffuse(pbrInputs);
   vec3 specContrib = F * G * D / (4.0 * NdotL * NdotV);
-  // A pixel covering many surfaces (needles): their mean clamped cosine is, to first order (L1
-  // spherical harmonics), 1/4 + (mean normal . l) / 2, linear so it survives blending and
-  // mipmaps. It sharpens to the plain cosine as the normals agree; for one normal it is exact.
-  float coherence = length(meanNormal);
-  float cosine = dot(meanNormal, l);
-  NdotL = mix(clamp(0.25 + 0.5 * cosine, 0.0, 1.0), max(cosine / max(coherence, 0.0001), 0.0), pow(coherence, 4.0));
+  // A pixel covering many surfaces (needles): the cosine of their mean normal, which the
+  // disagreeing normals shorten (and so darken). The first-order mean clamped cosine (1/4 + mean
+  // normal . l / 2) lit needles facing away from the sun by a quarter of it: without a crown's
+  // shading of its own needles, backlit crowns glowed where a path tracer has them near black.
+  NdotL = max(dot(meanNormal, l), 0.0);
   // Obtain final intensity as reflectance (BRDF) scaled by the energy of the light (cosine law)
   color = NdotL * lightColorAndIntensity.xyz * (diffuseContrib + specContrib) * lightColorAndIntensity.w;
 
@@ -674,8 +673,10 @@ void main() {
     l = -vec3(light.direction);
     h = normalize(l + v);
 
-    float visibility = i == int(shadows.params.y) ? (shadows.params.x > 0.0 ? sunVisibility(worldFragmentNormal, baked.b) : baked.b) :
-                                                    baked.g;
+    // Suns without shadow maps: the bake, and near the viewer the shadowed sun's maps as well (the
+    // source's two suns are 25 degrees apart: a crown shades its needles from both).
+    float mapped = shadows.params.x > 0.0 ? sunVisibility(worldFragmentNormal, baked.b) : baked.b;
+    float visibility = i == int(shadows.params.y) ? mapped : min(baked.g, mapped / max(baked.b, 0.05) * baked.g);
     color += visibility * PBRpass(l, viewFragmentNormal, v, h, light.colorAndIntensity, perceptualRoughness, metalness,
                                   specularEnvironmentR0, specularEnvironmentR90, alphaRoughness, diffuseColor, specularColor);
   }
diff --git a/resources/wren/shaders/scattering_fog.frag b/resources/wren/shaders/scattering_fog.frag
index 7395b6a..083090a 100644
--- a/resources/wren/shaders/scattering_fog.frag
+++ b/resources/wren/shaders/scattering_fog.frag
@@ -222,8 +222,9 @@ void main() {
     vec3 source;
     if (shadows.occlusionParams.x > 0.0) {  // sun 0 casts the shadow maps (B), sun 1 does not (G)
       vec4 visible = bakedVisibility(position);
-      source = skyIn * visible.r + phaseRadiance0 * shadowMapVisibility(position, visible.b) +
-               phaseRadiance1 * visible.g;
+      float mapped = shadowMapVisibility(position, visible.b);
+      // The second sun, 25 degrees from the first, shaded like it near the viewer (see pbr.frag).
+      source = skyIn * visible.r + phaseRadiance0 * mapped + phaseRadiance1 * min(visible.g, mapped / max(visible.b, 0.05) * visible.g);
     } else
       source = skyIn + phaseRadiance0 * sunVisibility(position, sunDirection0.xyz) +
                phaseRadiance1 * sunVisibility(position, sunDirection1.xyz);
