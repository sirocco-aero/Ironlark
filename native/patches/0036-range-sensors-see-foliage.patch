-layout(location = 0) in vec3 vCoord;
+// Distance along the view axis, for range sensors (RangeFinder, Lidar). With INSTANCED, for
+// instanced renderables (see pbr_instanced.vert).
 
-uniform mat4 modelTransform;
+layout(location = 0) in vec3 vCoord;
+layout(location = 2) in vec2 vTexCoord;
 
 out float distToCamera;
+out vec2 texUv;
+
+#ifdef INSTANCED
+uniform samplerBuffer instanceTransforms;
+uniform int instanceOffset;  // first instance of this draw call (mirrored instances draw separately)
+#else
+uniform mat4 modelTransform;
+#endif
 
 // Camera transforms for this frame
 layout(std140) uniform CameraTransforms {
@@ -15,11 +25,18 @@ layout(std140) uniform CameraTransforms {
 cameraTransforms;
 
 void main() {
-  mat4 modelView = cameraTransforms.view * modelTransform;
-
-  vec4 vCoordTransformed = modelView * vec4(vCoord, 1.0);
+#ifdef INSTANCED
+  int instance = 3 * (gl_InstanceID + instanceOffset);
+  vec4 p = vec4(vCoord, 1.0);
+  vec4 world = vec4(dot(texelFetch(instanceTransforms, instance), p), dot(texelFetch(instanceTransforms, instance + 1), p),
+                    dot(texelFetch(instanceTransforms, instance + 2), p), 1.0);
+  vec4 vCoordTransformed = cameraTransforms.view * world;
+#else
+  vec4 vCoordTransformed = cameraTransforms.view * modelTransform * vec4(vCoord, 1.0);
+#endif
 
   distToCamera = -vCoordTransformed.z;
+  texUv = vTexCoord;
 
   gl_Position = cameraTransforms.projection * vCoordTransformed;
 }
