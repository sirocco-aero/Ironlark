diff --git a/resources/wren/shaders/encode_depth.frag b/resources/wren/shaders/encode_depth.frag
index a652a52..c7d4f63 100644
--- a/resources/wren/shaders/encode_depth.frag
+++ b/resources/wren/shaders/encode_depth.frag
@@ -11,8 +11,35 @@ uniform float minRange;
 uniform float maxRange;
 
 in float distToCamera;
+in vec2 texUv;
+
+// Alpha-masked materials (PBR alphaCutoff) cut the same texels out of range images as out of the
+// color pass (pbr.frag): foliage cards are needles, not planes.
+uniform sampler2D inputTextures[1];
+uniform bool alphaMasked;
+
+layout(std140) uniform PbrMaterial {
+  vec4 baseColorAndTransparency;
+  vec4 roughnessMetalnessNormalMapFactorOcclusion;
+  vec4 backgroundColorAndIblStrength;
+  vec4 emissiveColorAndIntensity;
+  vec4 baseColorRoughnessMetalnessOcclusionMapFlags;
+  vec4 normalBrdfEmissiveBackgroundFlags;
+  vec4 penFlags;
+  vec4 cubeTextureFlags;
+  vec4 alphaCutoff;
+  vec4 transmission;
+}
+material;
 
 void main() {
+  if (alphaMasked && material.alphaCutoff.x > 0.0 && material.baseColorRoughnessMetalnessOcclusionMapFlags.x > 0.0) {
+    vec2 texel = texUv * vec2(textureSize(inputTextures[0], 0));
+    float mip = max(0.0, 0.5 * log2(max(dot(dFdx(texel), dFdx(texel)), dot(dFdy(texel), dFdy(texel)))));
+    if (texture(inputTextures[0], texUv).a * (1.0 + 0.25 * mip) < material.alphaCutoff.x)
+      discard;
+  }
+
   floatDepth = distToCamera;
 
   if (floatDepth < minRange)
diff --git a/resources/wren/shaders/encode_depth.vert b/resources/wren/shaders/encode_depth.vert
