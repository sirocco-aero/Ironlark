+#ifndef WB_WREN_TAA_HPP
+#define WB_WREN_TAA_HPP
+
+#include "WbWrenAbstractPostProcessingEffect.hpp"
+
+struct WrCamera;
+struct WrPostProcessingEffectPass;
+
+// Temporal anti-aliasing for the main view: jitters the camera by a sub-pixel offset every frame
+// and blends the frame with the reprojected history (taa.frag).
+class WbWrenTaa : public WbWrenAbstractPostProcessingEffect {
+public:
+  WbWrenTaa();
+
+  void setup(WrViewport *viewport) override;
+  void detachFromViewport() override;
+  // Before each frame: the next jitter, and the previous frame's view for the reprojection.
+  void update(WrCamera *camera);
+  // After each frame: keep the view it was drawn with.
+  void frameRendered(WrCamera *camera);
+
+protected:
+  void applyParametersToWren() override {}
+
+private:
+  WrPostProcessingEffectPass *mPass;
+  WrCamera *mCamera;
+  float mPreviousViewProjection[16];
+  bool mReset;
+  int mFrame;
+};
+
+#endif
