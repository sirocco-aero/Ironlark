+#ifdef WATER
+// Gradient noise and its derivatives (value, d/dx, d/dy), about -0.7..0.7, for water's ripples.
+vec2 waterGradient(ivec2 c) {
+  uint h = uint(c.x) * 0x8da6b343u ^ uint(c.y) * 0xd8163841u;
+  h ^= h >> 15u;
+  h *= 0x2c1b3c6du;
+  h ^= h >> 12u;
+  h *= 0x297a2d39u;
+  h ^= h >> 15u;
+  return vec2(float(h & 0xffffu), float(h >> 16u)) * (2.0 / 65535.0) - 1.0;
+}
+
+vec3 waterNoise(vec2 p) {
+  vec2 i = floor(p), f = p - i;
+  ivec2 c = ivec2(i);
+  vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
+  vec2 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
+  vec2 ga = waterGradient(c), gb = waterGradient(c + ivec2(1, 0));
+  vec2 gc = waterGradient(c + ivec2(0, 1)), gd = waterGradient(c + ivec2(1, 1));
+  float va = dot(ga, f), vb = dot(gb, f - vec2(1.0, 0.0)), vc = dot(gc, f - vec2(0.0, 1.0)), vd = dot(gd, f - vec2(1.0));
+  float k = va - vb - vc + vd;
+  return vec3(va + u.x * (vb - va) + u.y * (vc - va) + u.x * u.y * k,
+              ga + u.x * (gb - ga) + u.y * (gc - ga) + u.x * u.y * (ga - gb - gc + gd) + du * (u.yx * k + vec2(vb, vc) - va));
+}
+
+// Wind ripples (PBRAppearance.waves): the slope (dz/dx, dz/dy) of gradient-noise octaves over the
+// water's world xy, 3 m down to 0.1 m (a lake's short fetch builds no longer ones), each drifting
+// downwind at deep water's speed for its length. They blow in gusts: rougher patches travel across
+// calmer water, which lies glassy in streaks along the wind. Octaves finer than a few pixels are not
+// drawn: the variance of their slopes is returned, to widen the reflection as they would.
+const vec2 WIND = vec2(0.8, 0.6);
+
+vec2 waterRipples(vec2 xy, float slope, float footprint, out float variance) {
+  float t = simulationTime;
+  vec2 gusts = xy - WIND * 4.0 * t;
+  float gust = waterNoise(gusts / 110.0).x + 0.5 * waterNoise(gusts / 43.0 + 7.3).x;
+  float streak = waterNoise(vec2(dot(xy, WIND) / 300.0, dot(xy, vec2(-WIND.y, WIND.x)) / 18.0) + vec2(0.0, 0.004 * t)).x;
+  // Each octave's slope: the noise's gradient (about 0.5 rms) times c; six octaves make up slope.
+  float c = 0.2 * slope * clamp(0.75 + 2.0 * gust, 0.15, 2.0) * mix(1.0, 0.25, smoothstep(0.1, 0.28, streak));
+  vec2 total = vec2(0.0);
+  variance = 0.0;
+  float wavelength = 3.0;
+  mat2 turn = mat2(0.8, 0.6, -0.6, 0.8);
+  mat2 frame = mat2(1.0);
+  for (int i = 0; i < 6; ++i) {
+    float resolved = 1.0 - smoothstep(0.2 * wavelength, 0.5 * wavelength, footprint);
+    if (resolved > 0.0) {  // noise only where the octave shows: far away, most are variance alone
+      vec2 p = frame * (xy - WIND * sqrt(1.56 * wavelength) * t) / wavelength + float(i) * 17.1;
+      total += resolved * (transpose(frame) * waterNoise(p).yz * c);
+    }
+    variance += (1.0 - resolved * resolved) * 0.5 * c * c;
+    wavelength *= 0.5;
+    frame = turn * frame;
+  }
+  return total;
+}
+#endif
+
 vec4 SRGBtoLINEAR(vec4 srgbIn) {
   vec3 bLess = step(vec3(0.04045), srgbIn.xyz);
   vec3 linOut = mix(srgbIn.xyz / vec3(12.92), pow((srgbIn.xyz + vec3(0.055)) / vec3(1.055), vec3(2.4)), bLess);
@@ -727,6 +788,32 @@ void main() {
   }
 #endif
 
+#ifdef WATER
+  // Water: what lies behind it (the scene copy) is attenuated along the path to it, and ripples tilt it.
+  // A view without the copy sees it as clear water.
+  bool sceneCopy = textureSize(sceneDepth, 0).x >= 2;
+  vec2 screenUv = gl_FragCoord.xy / vec2(max(textureSize(sceneDepth, 0), ivec2(1)));
+  float behindDepth = texture(sceneDepth, screenUv).r;
+  float behindZ = behindDepth >= 1.0 ? 1e6 : -cameraTransforms.infiniteProjection[3][2] / (1.0 - behindDepth);
+  float path = max(behindZ + fragmentPosition.z, 0.0) * length(fragmentPosition) / max(-fragmentPosition.z, 1e-3);
+  vec3 through = vec3(1.0);
+  if (sceneCopy && material.water.y > 0.0)
+    through = pow(max(material.attenuationColor.rgb, vec3(1e-4)), vec3(min(path / material.water.y, 60.0)));
+  if (material.water.z > 0.0) {
+    float footprint = max(length(dFdx(surfacePosition)), length(dFdy(surfacePosition)));
+    float variance;
+    vec2 slope = waterRipples(surfacePosition.xy, material.water.z, footprint, variance);
+    worldFragmentNormal = normalize(worldFragmentNormal - vec3(slope, 0.0));
+    viewFragmentNormal = transpose(inverseViewMatrix) * worldFragmentNormal;
+    // Keep it facing the viewer: a tilt past the view ray would mirror what lies under the surface.
+    vec3 toEye = normalize(-fragmentPosition);
+    viewFragmentNormal = normalize(viewFragmentNormal + max(0.05 - dot(viewFragmentNormal, toEye), 0.0) * toEye);
+    worldFragmentNormal = inverseViewMatrix * viewFragmentNormal;
+    alphaRoughness = sqrt(alphaRoughness * alphaRoughness + variance);
+    perceptualRoughness = sqrt(alphaRoughness);
+  }
+#endif
+
   // Alpha mask (glTF MASK): each texel is kept or discarded, never blended.
   // Mipmaps average alpha and would thin distant foliage, so alpha is scaled
   // by the sampled mip level to preserve coverage.
@@ -758,6 +845,10 @@ void main() {
   vec3 f0 = vec3(0.04);
   vec3 diffuseColor = baseColor.rgb * (vec3(1.0) - f0) * (1.0 - transmitted);  // light passing through is not diffused
   diffuseColor *= 1.0 - metalness;
+#ifdef WATER
+  // The water's own colour: what the light it scatters back adds where its path is long.
+  diffuseColor = material.scatterColor.rgb * (vec3(1.0) - through);
+#endif
   vec3 specularColor = mix(f0, baseColor.rgb, metalness);
 
   // Compute reflectance.
@@ -893,11 +984,21 @@ void main() {
   if (material.transmission.x > 0.0) {
     // What the surface mirrors: the opaque scene where a screen-space ray finds it, the sky else.
     vec4 mirrored = screenSpaceReflection(fragmentPosition, viewFragmentNormal);
+#ifdef WATER
+    // Rippled water blurs what it mirrors: the sky map's blur, rather than a sharp scene.
+    mirrored.a *= 1.0 - smoothstep(0.1, 0.4, perceptualRoughness);
+#endif
     color.rgb += mirrored.a * (mirrored.rgb - iblReflection) * iblReflectionWeight;
     // Premultiplied: reflection and foam are added; the scene behind shows through the
     // transmitted share left after Fresnel reflection (water IOR 1.333: F0 = 0.02).
     float fresnel = 0.02 + 0.98 * pow(1.0 - clamp(dot(viewFragmentNormal, normalize(-fragmentPosition)), 0.0, 1.0), 5.0);
-    fragColor = vec4(color.rgb, 1.0 - transmitted * (1.0 - fresnel));
+#ifdef WATER
+    // Attenuated per channel: composited here, from the scene copy, rather than blended.
+    if (sceneCopy)
+      fragColor = vec4(color.rgb + texture(sceneColor, screenUv).rgb * through * transmitted * (1.0 - fresnel), 1.0);
+    else
+#endif
+      fragColor = vec4(color.rgb, 1.0 - transmitted * (1.0 - fresnel));
   }
 
   if (fog.mode.x > 0.0) {
