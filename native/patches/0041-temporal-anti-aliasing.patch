+
+// Temporal anti-aliasing: this frame blended with the reprojected history; a copy of the result
+// feeds the next frame (loopback), and is the effect's result.
+WrPostProcessingEffect *WbWrenPostProcessingEffects::taa(float width, float height, WrTexture *depthTexture) {
+  WrPostProcessingEffect *effect = wr_post_processing_effect_new();
+  wr_post_processing_effect_set_drawing_index(effect, WbWrenRenderingContext::PP_TAA);
+
+  WrPostProcessingEffectPass *blend = wr_post_processing_effect_pass_new();
+  wr_post_processing_effect_pass_set_name(blend, "taa");
+  wr_post_processing_effect_pass_set_program(blend, WbWrenShaders::taaShader());
+  wr_post_processing_effect_pass_set_output_size(blend, width, height);
+  wr_post_processing_effect_pass_set_input_texture_count(blend, 3);
+  wr_post_processing_effect_pass_set_input_texture(blend, 2, depthTexture);
+  for (int i = 0; i < 3; ++i)
+    wr_post_processing_effect_pass_set_input_texture_wrap_mode(blend, i, WR_TEXTURE_WRAP_MODE_CLAMP_TO_EDGE);
+  wr_post_processing_effect_pass_set_input_texture_interpolation(blend, 0, false);
+  wr_post_processing_effect_pass_set_input_texture_interpolation(blend, 1, true);
+  wr_post_processing_effect_pass_set_input_texture_interpolation(blend, 2, false);
+  wr_post_processing_effect_pass_set_alpha_blending(blend, false);
+  wr_post_processing_effect_pass_set_clear_before_draw(blend, true);
+  wr_post_processing_effect_pass_set_output_texture_count(blend, 1);
+  wr_post_processing_effect_pass_set_output_texture_format(blend, 0, WR_TEXTURE_INTERNAL_FORMAT_RGBA16F);
+  wr_post_processing_effect_append_pass(effect, blend);
+
+  WrPostProcessingEffectPass *history = wr_post_processing_effect_pass_new();
+  wr_post_processing_effect_pass_set_name(history, "taaHistory");
+  wr_post_processing_effect_pass_set_program(history, WbWrenShaders::passThroughShader());
+  wr_post_processing_effect_pass_set_output_size(history, width, height);
+  wr_post_processing_effect_pass_set_input_texture_count(history, 1);
+  wr_post_processing_effect_pass_set_input_texture_wrap_mode(history, 0, WR_TEXTURE_WRAP_MODE_CLAMP_TO_EDGE);
+  wr_post_processing_effect_pass_set_input_texture_interpolation(history, 0, false);
+  wr_post_processing_effect_pass_set_alpha_blending(history, false);
+  wr_post_processing_effect_pass_set_clear_before_draw(history, true);
+  wr_post_processing_effect_pass_set_output_texture_count(history, 1);
+  wr_post_processing_effect_pass_set_output_texture_format(history, 0, WR_TEXTURE_INTERNAL_FORMAT_RGBA16F);
+  wr_post_processing_effect_append_pass(effect, history);
+
+  wr_post_processing_effect_connect(effect, blend, 0, history, 0);
+  wr_post_processing_effect_connect(effect, history, 0, blend, 1);  // loopback: next frame's history
+
+  wr_post_processing_effect_set_result_program(effect, WbWrenShaders::passThroughShader());
+  return effect;
+}
