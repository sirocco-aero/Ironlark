+static float halton(int index, int base) {
+  float f = 1.0f, r = 0.0f;
+  for (int i = index; i > 0; i /= base) {
+    f /= base;
+    r += f * (i % base);
+  }
+  return r;
+}
+
+WbWrenTaa::WbWrenTaa() :
+  WbWrenAbstractPostProcessingEffect(),
+  mPass(NULL),
+  mCamera(NULL),
+  mPreviousViewProjection(),
+  mReset(true),
+  mFrame(0) {
+}
+
+void WbWrenTaa::setup(WrViewport *viewport) {
+  if (mWrenPostProcessingEffect) {
+    if (mWrenViewport == viewport)
+      wr_viewport_remove_post_processing_effect(mWrenViewport, mWrenPostProcessingEffect);
+    wr_post_processing_effect_delete(mWrenPostProcessingEffect);
+  }
+  mWrenViewport = viewport;
+  WrTexture *depth = WR_TEXTURE(wr_frame_buffer_get_depth_texture(wr_viewport_get_frame_buffer(mWrenViewport)));
+  mWrenPostProcessingEffect = WbWrenPostProcessingEffects::taa(wr_viewport_get_width(mWrenViewport),
+                                                              wr_viewport_get_height(mWrenViewport), depth);
+  mPass = wr_post_processing_effect_get_pass(mWrenPostProcessingEffect, "taa");
+  WbWrenOpenGlContext::makeWrenCurrent();
+  wr_viewport_add_post_processing_effect(mWrenViewport, mWrenPostProcessingEffect);
+  wr_post_processing_effect_setup(mWrenPostProcessingEffect);
+  WbWrenOpenGlContext::doneWren();
+  mReset = true;
+  mHasBeenSetup = true;
+}
+
+void WbWrenTaa::detachFromViewport() {
+  if (mWrenViewport && mWrenPostProcessingEffect) {
+    wr_viewport_remove_post_processing_effect(mWrenViewport, mWrenPostProcessingEffect);
+    wr_post_processing_effect_delete(mWrenPostProcessingEffect);
+  }
+  if (mCamera)
+    wr_camera_set_jitter(mCamera, 0.0f, 0.0f);
+  mWrenPostProcessingEffect = NULL;
+  mWrenViewport = NULL;
+  mPass = NULL;
+  mHasBeenSetup = false;
+}
+
+void WbWrenTaa::frameRendered(WrCamera *camera) {
+  // The view the frame was drawn with (the viewpoint's pose reaches the camera during rendering).
+  if (mPass)
+    wr_camera_get_unjittered_view_projection(camera, mPreviousViewProjection);
+}
+
+void WbWrenTaa::update(WrCamera *camera) {
+  if (!mPass)
+    return;
+  mCamera = camera;
+  WbWrenOpenGlContext::makeWrenCurrent();
+  // The history was rendered with the previous view; a new setup starts from this frame alone.
+  wr_post_processing_effect_pass_set_program_parameter(mPass, "previousViewProjection",
+                                                       reinterpret_cast<const char *>(mPreviousViewProjection));
+  wr_post_processing_effect_pass_set_program_parameter(mPass, "reset", reinterpret_cast<const char *>(&mReset));
+  mReset = false;
+  // Halton (2, 3) over 16 frames, centred: offsets within one pixel.
+  mFrame = (mFrame + 1) % 16;
+  const float width = wr_viewport_get_width(mWrenViewport), height = wr_viewport_get_height(mWrenViewport);
+  wr_camera_set_jitter(camera, (halton(mFrame + 1, 2) - 0.5f) * 2.0f / width, (halton(mFrame + 1, 3) - 0.5f) * 2.0f / height);
+  WbWrenOpenGlContext::doneWren();
+}
