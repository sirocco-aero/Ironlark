new file mode 100644
index 0000000..16ff013
--- /dev/null
+++ b/resources/wren/shaders/taa.frag
@@ -0,0 +1,120 @@
+#version 330 core
+
+precision highp float;
+
+// Temporal anti-aliasing (main view): each frame renders with a sub-pixel jitter; this pass blends
+// it with the history, reprojected through the depth buffer into the previous frame's (unjittered)
+// view, and clamped to the current neighbourhood so that moving objects and disocclusions do not
+// ghost. Sub-pixel detail (needles) then resolves to its coverage instead of flickering. In linear
+// HDR, before tone mapping; weighted by 1 / (1 + luminance) so bright texels do not dominate.
+
+// 0: this frame (HDR), 1: history (HDR), 2: depth
+uniform sampler2D inputTextures[3];
+
+uniform mat4 previousViewProjection;  // unjittered
+uniform bool reset;
+
+in vec2 texUv;
+out vec4 result;
+
+layout(std140) uniform CameraTransforms {
+  mat4 view;
+  mat4 projection;
+  mat4 infiniteProjection;
+}
+cameraTransforms;
+
+// Share of this frame: small at rest (sub-pixel detail converges), larger in motion (less lag).
+const float CURRENT_WEIGHT = 0.06;
+const float MOVING_WEIGHT = 0.25;
+
+vec3 toYCoCg(vec3 c) {
+  return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
+}
+
+vec3 fromYCoCg(vec3 c) {
+  return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
+}
+
+// The history resampled with a Catmull-Rom filter (9 taps): bilinear filtering would blur it a
+// little more every frame.
+vec3 historyCatmullRom(vec2 uv) {
+  vec2 size = vec2(textureSize(inputTextures[1], 0));
+  vec2 position = uv * size;
+  vec2 centre = floor(position - 0.5) + 0.5;
+  vec2 f = position - centre;
+  vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
+  vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
+  vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
+  vec2 w3 = f * f * (-0.5 + 0.5 * f);
+  vec2 w12 = w1 + w2;
+  vec2 offset12 = w2 / w12;
+  vec2 t0 = (centre - 1.0) / size, t3 = (centre + 2.0) / size, t12 = (centre + offset12) / size;
+  vec3 c = vec3(0.0);
+  c += texture(inputTextures[1], vec2(t0.x, t0.y)).rgb * w0.x * w0.y;
+  c += texture(inputTextures[1], vec2(t12.x, t0.y)).rgb * w12.x * w0.y;
+  c += texture(inputTextures[1], vec2(t3.x, t0.y)).rgb * w3.x * w0.y;
+  c += texture(inputTextures[1], vec2(t0.x, t12.y)).rgb * w0.x * w12.y;
+  c += texture(inputTextures[1], vec2(t12.x, t12.y)).rgb * w12.x * w12.y;
+  c += texture(inputTextures[1], vec2(t3.x, t12.y)).rgb * w3.x * w12.y;
+  c += texture(inputTextures[1], vec2(t0.x, t3.y)).rgb * w0.x * w3.y;
+  c += texture(inputTextures[1], vec2(t12.x, t3.y)).rgb * w12.x * w3.y;
+  c += texture(inputTextures[1], vec2(t3.x, t3.y)).rgb * w3.x * w3.y;
+  return max(c, vec3(0.0));
+}
+
+float luminanceWeight(vec3 c) {
+  return 1.0 / (1.0 + dot(c, vec3(0.2126, 0.7152, 0.0722)));
+}
+
+void main() {
+  vec3 current = max(texture(inputTextures[0], texUv).rgb, vec3(0.0));
+  // The history's alpha keeps each pixel's view depth: reprojected history from another surface
+  // (revealed behind moving foliage) is rejected.
+  float depth = texture(inputTextures[2], texUv).r;
+  float near = -cameraTransforms.infiniteProjection[3][2];
+  float viewDepth = depth >= 1.0 ? 1e4 : near / max(1.0 - depth, 1e-7);
+  if (reset) {
+    result = vec4(current, viewDepth);
+    return;
+  }
+
+  // The history is clamped to the neighbourhood's range (YCoCg): wide enough that sub-pixel
+  // foliage, which changes with every jitter, still accumulates; tight enough against ghosts.
+  ivec2 pixel = ivec2(gl_FragCoord.xy);
+  ivec2 size = textureSize(inputTextures[0], 0);
+  vec3 low = vec3(1e9), high = vec3(-1e9);
+  for (int dy = -1; dy <= 1; ++dy)
+    for (int dx = -1; dx <= 1; ++dx) {
+      vec3 c = toYCoCg(max(texelFetch(inputTextures[0], clamp(pixel + ivec2(dx, dy), ivec2(0), size - 1), 0).rgb, 0.0));
+      low = min(low, c);
+      high = max(high, c);
+    }
+
+  // Reproject: this pixel's world point (or, for the sky, its direction) in the previous frame.
+  vec4 world = inverse(cameraTransforms.infiniteProjection * cameraTransforms.view) * vec4(texUv * 2.0 - 1.0, depth, 1.0);
+  if (depth >= 1.0)
+    world.w = 0.0;
+  vec4 previous = previousViewProjection * world;
+  vec2 previousUv = previous.xy / previous.w * 0.5 + 0.5;
+  if ((depth < 1.0 && previous.w <= 0.0) || any(lessThan(previousUv, vec2(0.0))) ||
+      any(greaterThan(previousUv, vec2(1.0)))) {
+    result = vec4(current, viewDepth);
+    return;
+  }
+  if (depth < 1.0) {  // previous.w: this point's view depth in the previous frame
+    float stored = textureLod(inputTextures[1], previousUv, 0.0).a;
+    if (abs(stored - previous.w) > 0.03 * previous.w + 0.05) {
+      result = vec4(current, viewDepth);
+      return;
+    }
+  }
+  float motion = length((previousUv - texUv) * vec2(size));
+  float currentWeight = mix(CURRENT_WEIGHT, MOVING_WEIGHT, clamp(motion / 3.0, 0.0, 1.0));
+
+  vec3 history = toYCoCg(historyCatmullRom(previousUv));
+  history = fromYCoCg(clamp(history, low, high));
+  float wc = currentWeight * luminanceWeight(current);
+  float wh = (1.0 - currentWeight) * luminanceWeight(history);
+  result = vec4((current * wc + history * wh) / (wc + wh), viewDepth);
+}
