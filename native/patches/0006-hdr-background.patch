diff --git a/resources/wren/shaders/skybox.frag b/resources/wren/shaders/skybox.frag
index aefd48c..4bfd8c9 100644
--- a/resources/wren/shaders/skybox.frag
+++ b/resources/wren/shaders/skybox.frag
@@ -9,10 +9,12 @@ layout(location = 1) out vec3 fragNormal;
 in vec3 texUv;
 
 uniform samplerCube cubeTextures[1];
+uniform float linear;  // 1: HDR radiance, 0: 8-bit image needing decoding
 
 void main() {
   // invert z components of sample vector due to VRML default camera orientation looking towards -z
   fragNormal = vec3(0.0);
   fragColor = textureLod(cubeTextures[0], vec3(texUv.xy, -texUv.z), 0.0);
-  fragColor.rgb = pow(fragColor.rgb, vec3(GAMMA));
+  if (linear < 0.5)
+    fragColor.rgb = pow(fragColor.rgb, vec3(GAMMA));
 }
