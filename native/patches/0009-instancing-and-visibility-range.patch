+    wr_shader_program_use_uniform(gShaders[SHADER_PBR_INSTANCED], WR_GLSL_LAYOUT_UNIFORM_TEXTURE6);  // emissive texture
+    wr_shader_program_use_uniform(gShaders[SHADER_PBR_INSTANCED], WR_GLSL_LAYOUT_UNIFORM_TEXTURE7);  // background texture (for displays)
+    wr_shader_program_use_uniform(gShaders[SHADER_PBR_INSTANCED], WR_GLSL_LAYOUT_UNIFORM_TEXTURE8);  // pen texture
