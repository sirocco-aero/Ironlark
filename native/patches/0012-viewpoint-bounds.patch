+namespace {
+  struct GroundProbe {
+    dGeomID ray;
+    double top;  // highest contact found
+  };
+
+  void probeGround(void *data, dGeomID ray, dGeomID geom) {
+    if (dGeomIsSpace(geom)) {
+      dSpaceCollide2(ray, geom, data, &probeGround);
+      return;
+    }
+    GroundProbe *probe = static_cast<GroundProbe *>(data);
+    dContactGeom contact;
+    if (dCollide(ray, geom, 1, &contact, sizeof(dContactGeom)) > 0)
+      probe->top = std::max(probe->top, static_cast<double>(contact.pos[2]));
+  }
+}  // namespace
+
+// Keeps the viewpoint inside its bounds and above the solid below it, so navigation slides
+// along those limits instead of leaving the world.
+WbVector3 WbViewpoint::constrainedPosition(const WbVector3 &position) const {
+  WbVector3 p = position;
+  const WbVector3 &low = mBoundsMin->value(), &high = mBoundsMax->value();
+  for (int i = 0; i < 3; ++i)
+    if (low[i] < high[i])
+      p[i] = qBound(low[i], p[i], high[i]);
+
+  const double clearance = mGroundClearance->value();
+  WbOdeContext *ode = WbOdeContext::instance();
+  if (clearance > 0.0 && ode && ode->space()) {
+    // Cast from high above straight down; the highest hit is the ground (or object) below.
+    const double from = p.z() + 1000.0;
+    dGeomID ray = dCreateRay(NULL, 2000.0);
+    dGeomRaySet(ray, p.x(), p.y(), from, 0.0, 0.0, -1.0);
+    GroundProbe probe = {ray, -INFINITY};
+    dSpaceCollide2(ray, reinterpret_cast<dGeomID>(ode->space()), &probe, &probeGround);
+    dGeomDestroy(ray);
+    if (std::isfinite(probe.top))
+      p.setZ(std::max(p.z(), probe.top + clearance));
+  }
+  return p;
+}
+
 void WbViewpoint::updatePosition() {
+  const WbVector3 constrained = constrainedPosition(mPosition->value());
+  if (constrained != mPosition->value()) {
+    mPosition->setValue(constrained);  // re-emits changed, which applies it
+    return;
+  }
   if (areWrenObjectsInitialized()) {
     applyPositionToWren();
     emit cameraParametersChanged();
