 out vec3 worldPosition;
 out vec3 fragmentNormal;
 out vec2 texUv;
 out vec2 penTexUv;
-out mat3 inverseViewMatrix;
 
 uniform samplerBuffer instanceTransforms;
 uniform int instanceOffset;  // first instance of this draw call (mirrored instances draw separately)
@@ -32,19 +33,24 @@ void main() {
   vec4 row0 = texelFetch(instanceTransforms, instance);
   vec4 row1 = texelFetch(instanceTransforms, instance + 1);
   vec4 row2 = texelFetch(instanceTransforms, instance + 2);
-  mat4 modelTransform = mat4(vec4(row0.x, row1.x, row2.x, 0.0), vec4(row0.y, row1.y, row2.y, 0.0),
-                             vec4(row0.z, row1.z, row2.z, 0.0), vec4(row0.w, row1.w, row2.w, 1.0));
 
-  inverseViewMatrix = mat3(inverse(cameraTransforms.view));
-  mat4 modelView = cameraTransforms.view * modelTransform;
-
-  worldPosition = vec3(modelTransform * vec4(vCoord, 1.0));
-  vec4 vCoordTransformed = modelView * vec4(vCoord, 1.0);
+  vec4 p = vec4(vCoord, 1.0);
+  worldPosition = vec3(dot(row0, p), dot(row1, p), dot(row2, p));
+  vec4 vCoordTransformed = cameraTransforms.view * vec4(worldPosition, 1.0);
   fragmentPosition = vec3(vCoordTransformed);
   gl_Position = cameraTransforms.infiniteProjection * vCoordTransformed;
 
-  fragmentNormal = normalize(mat3(transpose(inverse(modelView))) * vNormal);
+  // Normals go through the inverse transpose of the instance's rotation and scale: its cofactors
+  // over its determinant (rows r0, r1, r2). The view is rigid, so it turns them as it turns points.
+  vec3 r0 = row0.xyz, r1 = row1.xyz, r2 = row2.xyz;
+  vec3 c0 = cross(r1, r2);
+  vec3 normal = vec3(dot(c0, vNormal), dot(cross(r2, r0), vNormal), dot(cross(r0, r1), vNormal)) / dot(r0, c0);
+  fragmentNormal = normalize(mat3(cameraTransforms.view) * normal);
 
   texUv = vec2(textureTransform * vec4(vTexCoord, 0.0, 1.0));
