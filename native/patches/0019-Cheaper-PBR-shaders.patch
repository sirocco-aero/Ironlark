diff --git a/resources/wren/shaders/pbr.frag b/resources/wren/shaders/pbr.frag
index 24b7edb4ae9af1c5bc4dc43fac63302d174dd70f..41e72ebbad3f3276e49453759072baba492e2465 100644
--- a/resources/wren/shaders/pbr.frag
+++ b/resources/wren/shaders/pbr.frag
@@ -15,7 +15,6 @@ in vec3 worldPosition;
 in vec3 fragmentNormal;
 in vec2 texUv;
 in vec2 penTexUv;
-in mat3 inverseViewMatrix;
 layout(std140) uniform CameraTransforms {
   mat4 view;
   mat4 projection;
@@ -23,6 +22,9 @@ layout(std140) uniform CameraTransforms {
 }
 cameraTransforms;
 
+// The view is rigid (a look-at): its inverse rotation is its transpose.
+mat3 inverseViewMatrix;
+
 #ifdef IMPOSTOR
 in vec3 impostorLocal[3];      // position in each captured view (0..1 inside it), and its weight
 flat in vec2 impostorCell[3];  // each view's cell in the atlas
@@ -585,7 +587,14 @@ vec4 screenSpaceReflection(vec3 position, vec3 normal) {
 }
 
 void main() {
+  inverseViewMatrix = transpose(mat3(cameraTransforms.view));
 #ifdef IMPOSTOR
+  // Coverage first, everywhere on the quad (it takes derivatives): most of a quad is empty, and
+  // there its depth and normals are not read nor its light computed.
+  vec4 impostorAlbedo = impostorColor();
+  float impostorCoverage = maskCoverage(impostorAlbedo.w * (1.0 - material.baseColorAndTransparency.w), material.alphaCutoff.x);
+  if (impostorCoverage <= 0.0)
+    discard;
   // Depth from the captured views: the texel's surface, for the depth buffer (so ambient
   // occlusion, fog and intersections see the tree's shape, not a flat quad) and for shadows.
   float depth = min(impostorDepth() - 1.0, 0.0);  // from the quad, at the sphere's front
@@ -657,7 +666,7 @@ void main() {
   // apply base color map if it exists, composite background texture if necessary
   if (material.baseColorRoughnessMetalnessOcclusionMapFlags.x > 0.0) {
 #ifdef IMPOSTOR
-    vec4 baseColorMapColor = impostorColor();
+    vec4 baseColorMapColor = impostorAlbedo;
 #else
     vec4 baseColorMapColor = SRGBtoLINEAR(texture(inputTextures[0], texUv));
 #endif
@@ -697,10 +706,7 @@ void main() {
 #ifdef IMPOSTOR
   // A texel's alpha is the fraction of it the needles cover, already averaged over the needles'
   // texels: the cutoff applies as is, with no mip compensation.
-  float coverage = maskCoverage(baseColor.w, material.alphaCutoff.x);
-  if (coverage <= 0.0)
-    discard;
-  baseColor.w = coverage;
+  baseColor.w = impostorCoverage;
 #else
   if (material.alphaCutoff.x > 0.0) {
     vec2 texel = texUv * vec2(textureSize(inputTextures[0], 0));
diff --git a/resources/wren/shaders/pbr.vert b/resources/wren/shaders/pbr.vert
index 260b67e6f55cfaa9331c0ea67bf463c2ceec3534..50c9e2b9d90c4b0b03409040549d6023131cb369 100644
--- a/resources/wren/shaders/pbr.vert
+++ b/resources/wren/shaders/pbr.vert
@@ -3,14 +3,15 @@
 layout(location = 0) in vec3 vCoord;
 layout(location = 1) in vec3 vNormal;
 layout(location = 2) in vec2 vTexCoord;
+#ifdef PEN  // the variant for materials with a pen texture (ShaderProgram::penVariant)
 layout(location = 4) in vec2 vUnwrappedTexCoord;
+#endif
 
 out vec3 fragmentPosition;
 out vec3 worldPosition;
 out vec3 fragmentNormal;
 out vec2 texUv;
 out vec2 penTexUv;
-out mat3 inverseViewMatrix;
 
 uniform mat4 modelTransform;
 uniform mat4 textureTransform;
@@ -24,16 +25,22 @@ layout(std140) uniform CameraTransforms {
 cameraTransforms;
 
 void main() {
-  inverseViewMatrix = mat3(inverse(cameraTransforms.view));
-  mat4 modelView = cameraTransforms.view * modelTransform;
-
-  worldPosition = vec3(modelTransform * vec4(vCoord, 1.0));
-  vec4 vCoordTransformed = modelView * vec4(vCoord, 1.0);
+  vec4 world = modelTransform * vec4(vCoord, 1.0);
+  worldPosition = vec3(world);
+  vec4 vCoordTransformed = cameraTransforms.view * world;
   fragmentPosition = vec3(vCoordTransformed);
   gl_Position = cameraTransforms.infiniteProjection * vCoordTransformed;
 
-  fragmentNormal = normalize(mat3(transpose(inverse(modelView))) * vNormal);
+  // As pbr_instanced.vert: the model's inverse transpose from its cofactors; the view is rigid.
+  mat3 m = transpose(mat3(modelTransform));  // rows of the model's rotation and scale
+  vec3 c0 = cross(m[1], m[2]);
+  vec3 normal = vec3(dot(c0, vNormal), dot(cross(m[2], m[0]), vNormal), dot(cross(m[0], m[1]), vNormal)) / dot(m[0], c0);
+  fragmentNormal = normalize(mat3(cameraTransforms.view) * normal);
 
   texUv = vec2(textureTransform * vec4(vTexCoord, 0.0, 1.0));
+#ifdef PEN
   penTexUv = vUnwrappedTexCoord;
+#else
+  penTexUv = vec2(0.0);  // unread: no pen texture
+#endif
 }
