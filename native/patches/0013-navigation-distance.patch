+double WbViewpoint::castRay(const WbVector3 &origin, const WbVector3 &direction, double length) const {
+  WbOdeContext *ode = WbOdeContext::instance();
+  if (!ode || !ode->space() || direction.isNull())
+    return -1.0;
+  const WbVector3 unit = direction.normalized();
+  dGeomID ray = dCreateRay(NULL, length);
+  dGeomRaySet(ray, origin.x(), origin.y(), origin.z(), unit.x(), unit.y(), unit.z());
+  RayProbe probe = {INFINITY};
+  dSpaceCollide2(ray, reinterpret_cast<dGeomID>(ode->space()), &probe, &probeRay);
+  dGeomDestroy(ray);
+  return std::isfinite(probe.nearest) ? probe.nearest : -1.0;
+}
