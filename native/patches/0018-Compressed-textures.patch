+// A DDS file with DX10 header and BC7 data (DXGI_FORMAT_BC7_UNORM), or opaque BC1 (DXGI_FORMAT_BC1_UNORM),
+// mip levels included. Its pixel format flag DDPF_ALPHAPIXELS says whether the alpha channel is used.
+bool WbImageTexture::loadCompressed(const QByteArray &file) {
+  const auto u32 = [&file](int offset) {
+    return static_cast<quint32>(static_cast<unsigned char>(file[offset])) |
+           static_cast<quint32>(static_cast<unsigned char>(file[offset + 1])) << 8 |
+           static_cast<quint32>(static_cast<unsigned char>(file[offset + 2])) << 16 |
+           static_cast<quint32>(static_cast<unsigned char>(file[offset + 3])) << 24;
+  };
+  const quint32 format = file.size() < 148 ? 0 : u32(128);
+  if (file.size() < 148 || !file.startsWith("DDS ") || file.mid(84, 4) != "DX10" ||
+      (format != 98 && format != 99 && format != 71 && format != 72)) {
+    warn(tr("Unsupported DDS texture '%1': only BC7 or BC1 with a DX10 header is read.").arg(path()));
+    return false;
+  }
+  mCompressedBc1 = format == 71 || format == 72;
+  mCompressedSize = QSize(u32(16), u32(12));
+  mCompressedLevels = qMax(1u, u32(28));
+  mIsMainTextureTransparent = u32(80) & 0x1;
+  mCompressed = file.mid(148);
+  return true;
+}
