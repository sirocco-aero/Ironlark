+  // Cascaded shadow maps for one directional light. Unlike stencil shadow volumes,
+  // any mesh can cast, alpha-masked texels included, and instanced renderables cast
+  // with the level of detail the viewer sees.
+  class ShadowMap {
+  public:
+    static const int TEXTURE_UNIT = 14;
+    static const int CASCADES = 3;
+
+    ShadowMap(ShaderProgram *program, ShaderProgram *instancedProgram, int size, float maxDistance);
+    ~ShadowMap();
+
+    // Renders the cascades covering this camera's view and publishes them to shaders.
+    void render(const Camera *camera, const DirectionalLight *light, int lightIndex,
+                const std::vector<Renderable *> &casters);
+    // Publishes "no shadow map": lights are then unshadowed by it.
+    void disable();
+
+  private:
+    void prepareGl();
+    void publish() const;
+
+    ShaderProgram *mProgram;
+    ShaderProgram *mInstancedProgram;
+    int mSize;
+    float mMaxDistance;
+    unsigned int mFrameBuffer;
+    unsigned int mDepthTexture;
+    GlslLayout::Shadows mShadows;
+    // Far cascades are reused while the view still fits them (see render()).
+    glm::vec3 mCachedCenter[CASCADES];
+    float mCachedRadius[CASCADES];
+    glm::vec3 mCachedLightDirection;
+  };
+
