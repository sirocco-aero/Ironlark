diff --git a/resources/wren/shaders/pbr.frag b/resources/wren/shaders/pbr.frag
index 1d8b1f8111e8fc6c8630865675a62fd8fd7362d0..c983050733457ac82270a8332649038f36165a6d 100644
--- a/resources/wren/shaders/pbr.frag
+++ b/resources/wren/shaders/pbr.frag
@@ -8,6 +8,7 @@ const int maxPointLights = 48;
 const int maxSpotLights = 48;
 
 in vec3 fragmentPosition;
+in vec3 worldPosition;
 in vec3 fragmentNormal;
 in vec2 texUv;
 in vec2 penTexUv;
@@ -23,6 +24,36 @@ layout(location = 1) out vec4 fragNormal;
 uniform sampler2D inputTextures[13];
 uniform samplerCube cubeTextures[1];
 uniform bool reverseNormals;
+uniform sampler2DArrayShadow shadowMap;
+
+// Cascaded shadow maps of one directional light (see ShadowMap).
+layout(std140) uniform Shadows {
+  mat4 lightViewProjection[3];
+  vec4 splits;      // view distance at which each cascade ends
+  vec4 texelSizes;  // world size of a shadow map texel, per cascade
+  vec4 params;      // x: enabled, y: index of the light among directional lights
+}
+shadows;
+
+// Lit fraction of the shadowing light: 4 bilinear depth comparisons (16 texels), offset along
+// the normal by about a texel against self-shadowing, fading out past the last cascade.
+float sunVisibility(vec3 worldNormal) {
+  float distance = -fragmentPosition.z;
+  int cascade = distance < shadows.splits.x ? 0 : (distance < shadows.splits.y ? 1 : 2);
+  if (distance >= shadows.splits.z)
+    return 1.0;
+  vec3 p = worldPosition + worldNormal * 1.5 * shadows.texelSizes[cascade];
+  vec4 lightPosition = shadows.lightViewProjection[cascade] * vec4(p, 1.0);
+  vec3 c = lightPosition.xyz / lightPosition.w * 0.5 + 0.5;
+  vec2 texel = vec2(1.0) / vec2(textureSize(shadowMap, 0).xy);
+  float lit = 0.0;
+  for (int i = 0; i < 4; ++i) {
+    vec2 offset = (vec2(i & 1, i >> 1) - 0.5) * texel;
+    lit += texture(shadowMap, vec4(c.xy + offset, float(cascade), c.z));
+  }
+  float fade = clamp((shadows.splits.z - distance) / (0.1 * shadows.splits.z), 0.0, 1.0);
+  return mix(1.0, lit * 0.25, fade);
+}
 
 struct PBRInfo {
   float NdotL;                // cos angle between normal and light direction
@@ -340,8 +371,9 @@ void main() {
     l = -vec3(light.direction);
     h = normalize(l + v);
 
-    color += PBRpass(l, viewFragmentNormal, v, h, light.colorAndIntensity, perceptualRoughness, metalness,
-                     specularEnvironmentR0, specularEnvironmentR90, alphaRoughness, diffuseColor, specularColor);
+    float visibility = shadows.params.x > 0.0 && i == int(shadows.params.y) ? sunVisibility(worldFragmentNormal) : 1.0;
+    color += visibility * PBRpass(l, viewFragmentNormal, v, h, light.colorAndIntensity, perceptualRoughness, metalness,
+                                  specularEnvironmentR0, specularEnvironmentR90, alphaRoughness, diffuseColor, specularColor);
   }
 
