+}
diff --git a/resources/wren/shaders/shadow_depth_instanced.vert b/resources/wren/shaders/shadow_depth_instanced.vert
new file mode 100644
index 0000000000000000000000000000000000000000..092ab679aa1a844669eed5fbbc1c9455fe64729f
--- /dev/null
+++ b/resources/wren/shaders/shadow_depth_instanced.vert
@@ -0,0 +1,20 @@
+#version 330 core
+
+// Depth from the light for instanced renderables (see pbr_instanced.vert).
+
+layout(location = 0) in vec3 vCoord;
+layout(location = 2) in vec2 vTexCoord;
+
+out vec2 texUv;
+
+uniform samplerBuffer instanceTransforms;
+uniform mat4 lightViewProjection;
+
+void main() {
+  vec4 row0 = texelFetch(instanceTransforms, 3 * gl_InstanceID);
+  vec4 row1 = texelFetch(instanceTransforms, 3 * gl_InstanceID + 1);
+  vec4 row2 = texelFetch(instanceTransforms, 3 * gl_InstanceID + 2);
+  vec4 p = vec4(vCoord, 1.0);
+  texUv = vTexCoord;
+  gl_Position = lightViewProjection * vec4(dot(row0, p), dot(row1, p), dot(row2, p), 1.0);
+}
