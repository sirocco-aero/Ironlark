+#include "ShadowMap.hpp"
+
+#include "Camera.hpp"
+#include "DirectionalLight.hpp"
+#include "Frustum.hpp"
+#include "GlState.hpp"
+#include "Renderable.hpp"
+#include "ShaderProgram.hpp"
+#include "UniformBuffer.hpp"
+
+#include <wren/renderable.h>
+
+#ifdef __EMSCRIPTEN__
+#include <GL/gl.h>
+#include <GLES3/gl3.h>
+#else
+#include <glad/glad.h>
+#endif
+
+#include <glm/gtc/matrix_transform.hpp>
+
+#include <cmath>
+
+namespace wren {
+
+  // How far towards the light casters may stand in front of a cascade.
+  static const float CASTER_REACH = 200.0f;
+  // Blend of logarithmic and uniform cascade splits (the "practical" split scheme).
+  static const float SPLIT_BLEND = 0.8f;
+  // Far cascades cover this much more than the view needs, so the camera can move within
+  // them before they must be redrawn.
+  static const float CASCADE_SLACK = 1.25f;
+
+  ShadowMap::ShadowMap(ShaderProgram *program, ShaderProgram *instancedProgram, int size, float maxDistance) :
+    mProgram(program),
+    mInstancedProgram(instancedProgram),
+    mSize(size),
+    mMaxDistance(maxDistance),
+    mFrameBuffer(0),
+    mDepthTexture(0),
+    mShadows(),
+    mCachedRadius(),
+    mCachedLightDirection(0.0f) {
+  }
+
+  ShadowMap::~ShadowMap() {
+    if (mFrameBuffer)
+      glDeleteFramebuffers(1, &mFrameBuffer);
+    if (mDepthTexture)
+      glDeleteTextures(1, &mDepthTexture);
+  }
+
+  void ShadowMap::prepareGl() {
+    glGenTextures(1, &mDepthTexture);
+    glstate::activateTextureUnit(TEXTURE_UNIT);
+    glBindTexture(GL_TEXTURE_2D_ARRAY, mDepthTexture);
+    glTexImage3D(GL_TEXTURE_2D_ARRAY, 0, GL_DEPTH_COMPONENT32F, mSize, mSize, CASCADES, 0, GL_DEPTH_COMPONENT, GL_FLOAT,
+                 NULL);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    // Hardware depth comparison: each lookup returns a bilinearly filtered lit fraction.
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_COMPARE_MODE, GL_COMPARE_REF_TO_TEXTURE);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY, GL_TEXTURE_COMPARE_FUNC, GL_LEQUAL);
+    glGenFramebuffers(1, &mFrameBuffer);
+  }
+
+  void ShadowMap::render(const Camera *camera, const DirectionalLight *light, int lightIndex,
+                         const std::vector<Renderable *> &casters) {
+    if (!mDepthTexture)
+      prepareGl();
+
+    const glm::mat4 inverseView = glm::inverse(camera->view());
+    const glm::vec3 eye(inverseView[3]);
+    const glm::vec3 right(inverseView[0]), up(inverseView[1]), forward(-inverseView[2]);
+    const float tanHalfFovy = std::tan(0.5f * camera->fovy());
+    const float nearDistance = camera->nearDistance();
+    const glm::vec3 lightDirection = glm::normalize(light->direction());
+    const glm::vec3 lightUp = std::abs(lightDirection.z) < 0.99f ? glm::vec3(0.0f, 0.0f, 1.0f) : glm::vec3(0.0f, 1.0f, 0.0f);
+
+    glstate::bindFrameBuffer(mFrameBuffer);
+    glViewport(0, 0, mSize, mSize);
+    glstate::setColorMask(false, false, false, false);
+    glstate::setDepthMask(true);
+    glstate::setDepthTest(true);
+    glstate::setDepthFunc(GL_LESS);
+    glstate::setBlend(false);
+    glstate::setStencilTest(false);
+    glstate::setCullFace(false);  // foliage is two-sided
+    glEnable(GL_POLYGON_OFFSET_FILL);
+    glPolygonOffset(1.5f, 2.0f);
+
+    // Redraw the near cascade, which holds whatever moves near the viewer, every frame; far
+    // cascades only when the view leaves them or the light turns. Objects moving far from the
+    // viewer therefore cast stale shadows until then.
+    const bool refresh = lightDirection != mCachedLightDirection;
+    mCachedLightDirection = lightDirection;
+
+    float start = nearDistance;
+    for (int cascade = 0; cascade < CASCADES; ++cascade) {
+      const float t = static_cast<float>(cascade + 1) / CASCADES;
+      const float end = SPLIT_BLEND * nearDistance * std::pow(mMaxDistance / nearDistance, t) +
+                        (1.0f - SPLIT_BLEND) * (nearDistance + (mMaxDistance - nearDistance) * t);
+
+      // Bounding sphere of this slice of the view frustum: rotation-invariant, so the
+      // cascade does not change size (and shadows do not shimmer) as the view turns.
+      glm::vec3 corners[8];
+      int k = 0;
+      for (float d : {start, end}) {
+        const float halfHeight = d * tanHalfFovy, halfWidth = halfHeight * camera->aspectRatio();
+        for (float sx : {-1.0f, 1.0f})
+          for (float sy : {-1.0f, 1.0f})
+            corners[k++] = eye + forward * d + right * (sx * halfWidth) + up * (sy * halfHeight);
+      }
+      glm::vec3 center(0.0f);
+      for (const glm::vec3 &c : corners)
+        center += c / 8.0f;
+      float radius = 0.0f;
+      for (const glm::vec3 &c : corners)
+        radius = std::max(radius, glm::distance(center, c));
+      radius = std::ceil(radius * 2.0f) / 2.0f;
+
+      if (cascade > 0) {
+        if (!refresh && mCachedRadius[cascade] > 0.0f &&
+            glm::distance(center, mCachedCenter[cascade]) + radius <= mCachedRadius[cascade]) {
+          start = end;
+          continue;  // still covers the view: keep its depth and matrix
+        }
+        radius = std::ceil(radius * CASCADE_SLACK * 2.0f) / 2.0f;
+      }
+
+      // Snap the light-space origin to whole texels, so shadows keep still as the view moves.
+      const float texel = 2.0f * radius / mSize;
+      glm::mat4 lightView = glm::lookAt(-lightDirection, glm::vec3(0.0f), lightUp);
+      glm::vec4 origin = lightView * glm::vec4(center, 1.0f);
+      origin.x = std::floor(origin.x / texel) * texel;
+      origin.y = std::floor(origin.y / texel) * texel;
+      center = glm::vec3(glm::inverse(lightView) * origin);
+      lightView = glm::lookAt(center - lightDirection * (radius + CASTER_REACH), center, lightUp);
+      const glm::mat4 projection = glm::ortho(-radius, radius, -radius, radius, 0.0f, 2.0f * radius + CASTER_REACH);
+      const glm::mat4 viewProjection = projection * lightView;
+      const Frustum frustum(viewProjection);
+
+      glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, mDepthTexture, 0, cascade);
+      glClear(GL_DEPTH_BUFFER_BIT);
+      for (Renderable *caster : casters) {
+        if (!caster->castShadows() || caster->isTranslucent() || caster->drawingMode() != WR_RENDERABLE_DRAWING_MODE_TRIANGLES)
+          continue;
+        if (!caster->isInstanced() && caster->sceneCulling() && !frustum.isInside(caster->aabb()))
+          continue;
+        caster->renderShadow(mProgram, mInstancedProgram, viewProjection, frustum, eye);
+      }
+
+      mShadows.mLightViewProjection[cascade] = viewProjection;
+      mShadows.mSplits[cascade] = end;
+      mShadows.mTexelSizes[cascade] = texel;
+      mCachedCenter[cascade] = center;
+      mCachedRadius[cascade] = radius;
+      start = end;
+    }
+
+    glDisable(GL_POLYGON_OFFSET_FILL);
+    glstate::setColorMask(true, true, true, true);
+    mShadows.mParams = glm::vec4(1.0f, static_cast<float>(lightIndex), 0.0f, 0.0f);
+    publish();
+    glstate::activateTextureUnit(TEXTURE_UNIT);
+    glBindTexture(GL_TEXTURE_2D_ARRAY, mDepthTexture);
+  }
+
+  void ShadowMap::disable() {
+    mShadows.mParams = glm::vec4(0.0f);
+    publish();
+  }
+
+  void ShadowMap::publish() const {
+    glstate::uniformBuffer(WR_GLSL_LAYOUT_UNIFORM_BUFFER_SHADOWS)->writeValue(&mShadows);
+  }
+
+}  // namespace wren
