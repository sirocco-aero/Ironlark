diff --git a/resources/wren/shaders/shadow_depth.frag b/resources/wren/shaders/shadow_depth.frag
new file mode 100644
index 0000000000000000000000000000000000000000..706f353b942b788758a45e93070be1d68638600e
--- /dev/null
+++ b/resources/wren/shaders/shadow_depth.frag
@@ -0,0 +1,39 @@
+#version 330 core
+
+// Alpha-masked materials cast shadow in proportion to their coverage: each shadow texel keeps the
+// surface with probability equal to its (mipmapped) alpha, so filtered lookups let light through
+// foliage as the real needles do. A hard cutoff, boosted at coarse mip levels as the color pass is,
+// made whole crowns opaque to the sun. The pattern is fixed per texel: cascades are texel-snapped.
+
+in vec2 texUv;
+
+uniform sampler2D inputTextures[1];
+uniform bool alphaMasked;
+
+layout(std140) uniform PbrMaterial {
+  vec4 baseColorAndTransparency;
+  vec4 roughnessMetalnessNormalMapFactorOcclusion;
+  vec4 backgroundColorAndIblStrength;
+  vec4 emissiveColorAndIntensity;
+  vec4 baseColorRoughnessMetalnessOcclusionMapFlags;
+  vec4 normalBrdfEmissiveBackgroundFlags;
+  vec4 penFlags;
+  vec4 cubeTextureFlags;
+  vec4 alphaCutoff;
+  vec4 transmission;
+}
+material;
+
+void main() {
+  if (alphaMasked && material.alphaCutoff.x > 0.0 && material.baseColorRoughnessMetalnessOcclusionMapFlags.x > 0.0) {
+    // Coverage: the mask at the cutoff where texels are resolved; minified, where a shadow texel
+    // spans several texture texels, their mean alpha.
+    float alpha = texture(inputTextures[0], texUv).a;
+    vec2 texel = texUv * vec2(textureSize(inputTextures[0], 0));
+    float mip = max(0.0, 0.5 * log2(max(dot(dFdx(texel), dFdx(texel)), dot(dFdy(texel), dFdy(texel)))));
+    float coverage = mix(step(material.alphaCutoff.x, alpha), alpha, smoothstep(0.5, 2.0, mip));
+    float threshold = fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))));
+    if (coverage <= threshold)
+      discard;
+  }
+}
