-WrShaderProgram *WbWrenShaders::encodeDepthShader() {
-  if (!gShaders[SHADER_ENCODE_DEPTH]) {
-    gShaders[SHADER_ENCODE_DEPTH] = wr_shader_program_new();
+// Range sensors' depth; the renderable's own PBR material stays bound for its alpha mask (Renderable::render).
+static WrShaderProgram *encodeDepthProgram(int index, const char *defines) {
+  if (!gShaders[index]) {
+    WrShaderProgram *program = wr_shader_program_new();
+    gShaders[index] = program;
+    wr_shader_program_set_defines(program, defines);
 
-    wr_shader_program_use_uniform(gShaders[SHADER_ENCODE_DEPTH], WR_GLSL_LAYOUT_UNIFORM_MODEL_TRANSFORM);
+    wr_shader_program_use_uniform(program, WR_GLSL_LAYOUT_UNIFORM_MODEL_TRANSFORM);
+    wr_shader_program_use_uniform(program, WR_GLSL_LAYOUT_UNIFORM_TEXTURE0);  // base color, for its alpha mask
 
-    wr_shader_program_use_uniform_buffer(gShaders[SHADER_ENCODE_DEPTH], WR_GLSL_LAYOUT_UNIFORM_BUFFER_CAMERA_TRANSFORMS);
+    wr_shader_program_use_uniform_buffer(program, WR_GLSL_LAYOUT_UNIFORM_BUFFER_CAMERA_TRANSFORMS);
+    wr_shader_program_use_uniform_buffer(program, WR_GLSL_LAYOUT_UNIFORM_BUFFER_MATERIAL_PBR);
 
     float minRange = 0.0f;
     float maxRange = 1.0f;
-    wr_shader_program_create_custom_uniform(gShaders[SHADER_ENCODE_DEPTH], "minRange", WR_SHADER_PROGRAM_UNIFORM_TYPE_FLOAT,
+    const bool masked = false;
+    wr_shader_program_create_custom_uniform(program, "minRange", WR_SHADER_PROGRAM_UNIFORM_TYPE_FLOAT,
                                             reinterpret_cast<const char *>(&minRange));
-    wr_shader_program_create_custom_uniform(gShaders[SHADER_ENCODE_DEPTH], "maxRange", WR_SHADER_PROGRAM_UNIFORM_TYPE_FLOAT,
+    wr_shader_program_create_custom_uniform(program, "maxRange", WR_SHADER_PROGRAM_UNIFORM_TYPE_FLOAT,
                                             reinterpret_cast<const char *>(&maxRange));
+    wr_shader_program_create_custom_uniform(program, "alphaMasked", WR_SHADER_PROGRAM_UNIFORM_TYPE_BOOL,
+                                            reinterpret_cast<const char *>(&masked));
 
-    ::buildShader(gShaders[SHADER_ENCODE_DEPTH], QFileInfo("gl:shaders/encode_depth.vert"),
-                  QFileInfo("gl:shaders/encode_depth.frag"));
+    ::buildShader(program, QFileInfo("gl:shaders/encode_depth.vert"), QFileInfo("gl:shaders/encode_depth.frag"));
   }
 
-  return gShaders[SHADER_ENCODE_DEPTH];
+  return gShaders[index];
+}
+
+WrShaderProgram *WbWrenShaders::encodeDepthShader() {
+  return encodeDepthProgram(SHADER_ENCODE_DEPTH, "");
+}
+
+WrShaderProgram *WbWrenShaders::encodeDepthInstancedShader() {
+  return encodeDepthProgram(SHADER_ENCODE_DEPTH_INSTANCED, "#define INSTANCED\n");
 }
 
 WrShaderProgram *WbWrenShaders::fogShader() {
