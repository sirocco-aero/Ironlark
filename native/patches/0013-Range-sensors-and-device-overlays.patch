diff --git a/src/wren/Renderable.cpp b/src/wren/Renderable.cpp
index a173d9a6c75e967b84d74897bd1e4c770f0b07f6..9174b7f8f85942bb1764f252e0ed33d600ddfa2f 100644
--- a/src/wren/Renderable.cpp
+++ b/src/wren/Renderable.cpp
@@ -99,8 +99,20 @@ namespace wren {
     if (isInstanced() && (!effectiveProgram || glGetUniformLocation(effectiveProgram->glName(), "instanceTransforms") == -1))
       return;
 
-    // Only bind material program if no override program has been specified
-    mEffectiveMaterial->bind(!program);
+    // Range sensors' programs cut alpha-masked texels as the color pass does: as renderShadow, the
+    // renderable's own material binds its textures and uniform buffers, then that program draws.
+    const GLint alphaMasked = program ? -1 : glGetUniformLocation(effectiveProgram->glName(), "alphaMasked");
+    if (alphaMasked != -1 && mEffectiveMaterial != mDefaultMaterial && mDefaultMaterial->type() == WR_MATERIAL_PBR) {
+      mDefaultMaterial->setEffectiveProgram(Material::MATERIAL_PROGRAM_DEFAULT);
+      mDefaultMaterial->bind(true);
+      effectiveProgram->bind();
+      glUniform1i(alphaMasked, 1);
+    } else {
+      // Only bind material program if no override program has been specified
+      mEffectiveMaterial->bind(!program);
+      if (alphaMasked != -1)
+        glUniform1i(alphaMasked, 0);
+    }
 
     setupAndRender(effectiveProgram);
   }
