   else
     mOverlay->setVisible(true, areOverlaysEnabled());
diff --git a/src/webots/nodes/WbShape.cpp b/src/webots/nodes/WbShape.cpp
index ca685700ce126cb54488438313d00f72f873723e..ebcc9deb0e3b408ed1b82b038c4b279062f4616f 100644
--- a/src/webots/nodes/WbShape.cpp
+++ b/src/webots/nodes/WbShape.cpp
@@ -247,6 +247,10 @@ void WbShape::applyInstancingToGeometry() {
     return;
   wr_renderable_set_instances(renderable, mInstances.data(), static_cast<int>(mInstances.size() / 12));
   wr_renderable_set_scene_culling(renderable, false);  // culled per instance
+  // Range sensors see instances too; impostors (captured views, past any sensor's range) they skip.
