From: Zaid <283011337+nottzaid@users.noreply.github.com>
Date: Tue, 29 Sep 2026 12:00:00 +0300
Subject: [PATCH] Range sensors and device overlays

Range sensors (RangeFinder, Lidar) draw instanced shapes, which they
skipped, and cut alpha-masked texels as the colour pass does;
impostors stay out. A camera or range finder overlay created after the
world restored its perspective takes that perspective's saved
visibility, size and position instead of showing.

Replaces these patches of the numbered series, with what each measured
as it landed (tools/profile_forest.py, GTX 1060 3 GB, i5-4670):
- 0036-range-sensors-see-foliage: forest scan at 2.5 m: 20.8 k of 28.8 k
  returns, median 17 m
- 0040-device-overlay-perspective
---
 resources/wren/shaders/encode_depth.frag | 27 ++++++++++++++++++
 resources/wren/shaders/encode_depth.vert | 27 ++++++++++++++----
 src/webots/nodes/WbAbstractCamera.cpp    |  7 ++++-
 src/webots/nodes/WbShape.cpp             |  4 +++
 src/webots/wren/WbWrenCamera.cpp         | 12 ++++----
 src/webots/wren/WbWrenShaders.cpp        | 36 +++++++++++++++++-------
 src/webots/wren/WbWrenShaders.hpp        |  1 +
 src/wren/Renderable.cpp                  | 16 +++++++++--
 8 files changed, 106 insertions(+), 24 deletions(-)

diff --git a/resources/wren/shaders/encode_depth.frag b/resources/wren/shaders/encode_depth.frag
index a652a525816176abd29bef6b636bf38ee1b8a6b0..c7d4f638edefe57ce956f1f45b6b5b87dd51a2fb 100644
--- a/resources/wren/shaders/encode_depth.frag
+++ b/resources/wren/shaders/encode_depth.frag
@@ -11,8 +11,35 @@ uniform float minRange;
 uniform float maxRange;
 
 in float distToCamera;
+in vec2 texUv;
+
+// Alpha-masked materials (PBR alphaCutoff) cut the same texels out of range images as out of the
+// color pass (pbr.frag): foliage cards are needles, not planes.
+uniform sampler2D inputTextures[1];
+uniform bool alphaMasked;
+
+layout(std140) uniform PbrMaterial {
+  vec4 baseColorAndTransparency;
+  vec4 roughnessMetalnessNormalMapFactorOcclusion;
+  vec4 backgroundColorAndIblStrength;
+  vec4 emissiveColorAndIntensity;
+  vec4 baseColorRoughnessMetalnessOcclusionMapFlags;
+  vec4 normalBrdfEmissiveBackgroundFlags;
+  vec4 penFlags;
+  vec4 cubeTextureFlags;
+  vec4 alphaCutoff;
+  vec4 transmission;
+}
+material;
 
 void main() {
+  if (alphaMasked && material.alphaCutoff.x > 0.0 && material.baseColorRoughnessMetalnessOcclusionMapFlags.x > 0.0) {
+    vec2 texel = texUv * vec2(textureSize(inputTextures[0], 0));
+    float mip = max(0.0, 0.5 * log2(max(dot(dFdx(texel), dFdx(texel)), dot(dFdy(texel), dFdy(texel)))));
+    if (texture(inputTextures[0], texUv).a * (1.0 + 0.25 * mip) < material.alphaCutoff.x)
+      discard;
+  }
+
   floatDepth = distToCamera;
 
   if (floatDepth < minRange)
diff --git a/resources/wren/shaders/encode_depth.vert b/resources/wren/shaders/encode_depth.vert
index eee74c31c40ef1e84f8ff7da87b6f513ca099d66..35ef9deb5f515d91c29f61a999243c48c37e0a26 100644
--- a/resources/wren/shaders/encode_depth.vert
+++ b/resources/wren/shaders/encode_depth.vert
@@ -1,10 +1,20 @@
 #version 330 core
 
-layout(location = 0) in vec3 vCoord;
+// Distance along the view axis, for range sensors (RangeFinder, Lidar). With INSTANCED, for
+// instanced renderables (see pbr_instanced.vert).
 
-uniform mat4 modelTransform;
+layout(location = 0) in vec3 vCoord;
+layout(location = 2) in vec2 vTexCoord;
 
 out float distToCamera;
+out vec2 texUv;
+
+#ifdef INSTANCED
+uniform samplerBuffer instanceTransforms;
+uniform int instanceOffset;  // first instance of this draw call (mirrored instances draw separately)
+#else
+uniform mat4 modelTransform;
+#endif
 
 // Camera transforms for this frame
 layout(std140) uniform CameraTransforms {
@@ -15,11 +25,18 @@ layout(std140) uniform CameraTransforms {
 cameraTransforms;
 
 void main() {
-  mat4 modelView = cameraTransforms.view * modelTransform;
-
-  vec4 vCoordTransformed = modelView * vec4(vCoord, 1.0);
+#ifdef INSTANCED
+  int instance = 3 * (gl_InstanceID + instanceOffset);
+  vec4 p = vec4(vCoord, 1.0);
+  vec4 world = vec4(dot(texelFetch(instanceTransforms, instance), p), dot(texelFetch(instanceTransforms, instance + 1), p),
+                    dot(texelFetch(instanceTransforms, instance + 2), p), 1.0);
+  vec4 vCoordTransformed = cameraTransforms.view * world;
+#else
+  vec4 vCoordTransformed = cameraTransforms.view * modelTransform * vec4(vCoord, 1.0);
+#endif
 
   distToCamera = -vCoordTransformed.z;
+  texUv = vTexCoord;
 
   gl_Position = cameraTransforms.projection * vCoordTransformed;
 }
