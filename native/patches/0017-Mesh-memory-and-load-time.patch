+// A mesh read from a file goes to WREN as it is stored: a vertex list and triangles indexing it. Expanded per triangle
+// corner, as buildGeomIntoBuffers writes other geometries, it would be merged back into those vertices by WREN, which
+// numbers them by first use either way (StaticMesh::prepareGl): the same GPU mesh, built without the round trip.
+WrStaticMesh *WbTriangleMeshGeometry::buildIndexedWrenMesh() const {
+  const int vertexCount = mTriangleMesh->numberOfVertices();
+  const int triangleCount = mTriangleMesh->numberOfTriangles();
+  const WbMatrix4 m;  // as buildWrenMesh passes to buildGeomIntoBuffers
+  const WbMatrix3 rm = m.extracted3x3Matrix();
+  std::vector<float> coords(3 * vertexCount), normals(3 * vertexCount), texCoords(2 * vertexCount);
+  for (int v = 0; v < vertexCount; ++v) {
+    WbWrenMeshBuffers::writeCoordinates(mTriangleMesh->vertexCoordinate(v, 0), mTriangleMesh->vertexCoordinate(v, 1),
+                                        mTriangleMesh->vertexCoordinate(v, 2), m, coords.data(), 3 * v);
+    WbWrenMeshBuffers::writeNormal(mTriangleMesh->vertexNormal(v, 0), mTriangleMesh->vertexNormal(v, 1),
+                                   mTriangleMesh->vertexNormal(v, 2), rm, normals.data(), 3 * v);
+    texCoords[2 * v] = mTriangleMesh->vertexTextureCoordinate(v, 0);
+    texCoords[2 * v + 1] = mTriangleMesh->vertexTextureCoordinate(v, 1);
+  }
+  std::vector<unsigned int> indices(3 * triangleCount);
+  for (int t = 0; t < triangleCount; ++t)
+    for (int v = 0; v < 3; ++v)
+      indices[3 * t + v] = mTriangleMesh->vertexIndex(t, v);
+  return wr_static_mesh_new(vertexCount, static_cast<int>(indices.size()), coords.data(), normals.data(), texCoords.data(),
+                            texCoords.data(), indices.data(), false);
+}
