 #include <utility>
 
+static QHash<QString, std::shared_future<QImage>> gPrefetchedImages;
+
+void WbImageTexture::prefetchImage(const QString &path) {
+  const QString suffix = QFileInfo(path).suffix().toLower();
+  if (path.isEmpty() || gPrefetchedImages.contains(path) || (suffix != "png" && suffix != "jpg" && suffix != "jpeg") ||
+      !QFileInfo::exists(path))
+    return;
+  auto promise = std::make_shared<std::promise<QImage>>();
+  gPrefetchedImages.insert(path, promise->get_future().share());
+  QThreadPool::globalInstance()->start([promise, path]() {
+    QImage image;
+    QImageReader(path).read(&image);
+    promise->set_value(image);
+  });
+}
+
+bool WbImageTexture::takePrefetchedImage(const QString &path, QImage *image) {
+  const auto it = gPrefetchedImages.find(path);
+  if (it == gPrefetchedImages.end())
+    return false;
+  *image = it.value().get();
+  gPrefetchedImages.erase(it);
+  return !image->isNull();
+}
+
+void WbImagePrefetch::start(const WbNode *root) {
+  foreach (const WbNode *node, root->subNodes(true)) {
+    if (const WbImageTexture *texture = dynamic_cast<const WbImageTexture *>(node))
+      texture->prefetch();
+    else if (const WbBackground *background = dynamic_cast<const WbBackground *>(node))
+      background->prefetch();
+  }
+}
+
+void WbImagePrefetch::finish() {
+  gPrefetchedImages.clear();
+}
+
+void WbImageTexture::prefetch() const {
+  if (mUrl->size() > 0 && !WbUrl::isWeb(WbUrl::computePath(this, "url", mUrl->item(0))))
+    prefetchImage(path());
+}
