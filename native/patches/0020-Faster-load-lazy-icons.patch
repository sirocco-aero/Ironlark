+namespace {
+  // The icons are 512-pixel images: decoding every one at start took 83 MB, most of it for icons never drawn, or never
+  // drawn disabled. This engine reads an image the first time its mode is drawn, into a stock icon holding that image
+  // alone, and draws as a stock icon holding both would: the disabled image in Disabled mode, the enabled one otherwise.
+  class LazyButtonIconEngine : public QIconEngine {
+  public:
+    explicit LazyButtonIconEngine(const QString &fileName) :
+      mFiles{"enabledIcons:" + fileName, "disabledIcons:" + fileName} {}
+
+    // As QPixmapIconEngine::paint.
+    void paint(QPainter *painter, const QRect &rect, QIcon::Mode mode, QIcon::State state) override {
+      const QPaintDevice *device = painter->device();
+      const qreal ratio = device ? device->devicePixelRatio() : qApp->devicePixelRatio();
+      painter->drawPixmap(rect, scaledPixmap(rect.size() * ratio, mode, state, ratio));
+    }
+    // As QPixmapIconEngine::actualSize for one image, from the file's header.
+    QSize actualSize(const QSize &size, QIcon::Mode mode, QIcon::State state) override {
+      const int k = index(mode);
+      if (!mSizes[k].isValid())
+        mSizes[k] = QImageReader(mFiles[k]).size();
+      QSize actual = mSizes[k];
+      if (!actual.isNull() && (actual.width() > size.width() || actual.height() > size.height()))
+        actual.scale(size, Qt::KeepAspectRatio);
+      return actual;
+    }
+    QPixmap pixmap(const QSize &size, QIcon::Mode mode, QIcon::State state) override {
+      return scaledPixmap(size, mode, state, 1.0);
+    }
+    // With one image per mode, the scale does not change which image is drawn.
+    QPixmap scaledPixmap(const QSize &size, QIcon::Mode mode, QIcon::State state, qreal /* scale */) override {
+      return icon(mode).pixmap(size, 1.0, mode, state);
+    }
+    QList<QSize> availableSizes(QIcon::Mode mode, QIcon::State state) override {
+      return icon(mode).availableSizes(mode, state);
+    }
+    bool isNull() override { return false; }
+    QIconEngine *clone() const override { return new LazyButtonIconEngine(*this); }
+
+  private:
+    static int index(QIcon::Mode mode) { return mode == QIcon::Disabled ? 1 : 0; }
+    QIcon &icon(QIcon::Mode mode) {
+      const int k = index(mode);
+      if (mIcons[k].isNull())
+        mIcons[k].addFile(mFiles[k], QSize(), k ? QIcon::Disabled : QIcon::Normal);
+      return mIcons[k];
+    }
+
+    QString mFiles[2];
+    QSize mSizes[2];
+    QIcon mIcons[2];
+  };
+}  // namespace
+
+QIcon WbActionManager::buttonIcon(const QString &fileName) {
+  return QIcon(new LazyButtonIconEngine(fileName));
+}
