+#ifdef IMPOSTOR
+// Blends the three captured views chosen by pbr_impostor.vert. Past its frame's edges a view is empty.
+const float IMPOSTOR_FRAMES = 8.0;
+
+vec2 impostorUv(int k) {
+  vec2 local = clamp(impostorLocal[k].xy, 0.0, 1.0);
+  return (impostorCell[k] + vec2(local.x, 1.0 - local.y)) / IMPOSTOR_FRAMES;
+}
+
+float impostorWeight(int k) {
+  vec2 inside = step(vec2(0.0), impostorLocal[k].xy) * step(impostorLocal[k].xy, vec2(1.0));
+  return impostorLocal[k].z * inside.x * inside.y;
+}
+
+vec4 impostorColor() {
+  vec3 color = vec3(0.0);
+  float alpha = 0.0;
+  for (int k = 0; k < 3; ++k) {
+    vec4 view = SRGBtoLINEAR(texture(inputTextures[0], impostorUv(k)));
+    float weight = impostorWeight(k) * view.a;
+    color += weight * view.rgb;
+    alpha += weight;
+  }
+  return vec4(alpha > 0.0 ? color / alpha : color, alpha);
+}
+
+vec3 impostorNormal() {
+  vec3 normal = vec3(0.0);
+  for (int k = 0; k < 3; ++k)
+    normal += impostorWeight(k) * (texture(inputTextures[4], impostorUv(k)).rgb * 2.0 - 1.0);
+  return impostorToView * normal;  // not normalized: see meanNormal
+}
+
+// Where the texel lies in front of (> 0) or behind the sphere's centre, in capture-space units.
+float impostorDepth() {
+  float depth = 0.0;
+  for (int k = 0; k < 3; ++k)
+    depth += impostorWeight(k) * (texture(inputTextures[4], impostorUv(k)).a * 2.0 - 1.0);
+  return depth;
+}
+
+#endif
 
 void main() {
+#ifdef IMPOSTOR
+  // Depth from the captured views: the texel's surface, for the depth buffer (so ambient
+  // occlusion, fog and intersections see the tree's shape, not a flat quad) and for shadows.
+  float depth = min(impostorDepth() - 1.0, 0.0);  // from the quad, at the sphere's front
+  surfacePosition = worldPosition + impostorDepthAxis * depth;
+  vec4 clip = impostorClip + impostorClipAxis * depth;
+  // Window depth is NDC depth when WREN enables clip control (zero-to-one), else half of it plus
+  // one half: pick the mapping that reproduces this fragment's own depth.
+  float quadDepth = impostorClip.z / impostorClip.w;
+  bool zeroToOne = abs(gl_FragCoord.z - quadDepth) < abs(gl_FragCoord.z - (0.5 * quadDepth + 0.5));
+  gl_FragDepth = zeroToOne ? clip.z / clip.w : 0.5 * clip.z / clip.w + 0.5;
+#else
+  surfacePosition = worldPosition;
+#endif
