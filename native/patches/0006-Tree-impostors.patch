diff --git a/resources/wren/shaders/pbr_impostor.vert b/resources/wren/shaders/pbr_impostor.vert
new file mode 100644
index 0000000000000000000000000000000000000000..aaad1120890319839f1600e53e97ae6b47678d02
--- /dev/null
+++ b/resources/wren/shaders/pbr_impostor.vert
@@ -0,0 +1,98 @@
+#version 330 core
+
+// Impostors (Shape.impostor): each instance is a quad turned to face the camera, showing the
+// three captured views nearest the camera's direction, blended. Instance space holds the capture
+// sphere as the unit sphere. The atlas holds FRAMES x FRAMES orthographic views on a
+// hemi-octahedral grid: view (i, j) looks from gridToDirection((i, j) / (FRAMES - 1)) at the
+// origin, with right = cross(z, direction) and up = cross(direction, right); the grid's edges are
+// the horizon. View (i, j) fills atlas columns i and rows j (from the top of the image). The
+// normal map's alpha holds each texel's depth: -1 (far side of the sphere) to 1 (near side).
+
+layout(location = 0) in vec3 vCoord;  // quad corner (+-1, +-1, 0)
+
+out vec3 fragmentPosition;
+out vec3 worldPosition;
+out vec3 fragmentNormal;
+out vec2 texUv;
+out vec2 penTexUv;
+out mat3 inverseViewMatrix;
+out vec3 impostorLocal[3];      // position in each view (0..1 inside it), and the view's weight
+flat out vec2 impostorCell[3];  // each view's cell in the atlas
+out mat3 impostorToView;        // capture-space directions to view space
+out vec3 impostorDepthAxis;     // world offset of one capture-space unit towards the camera
+out vec4 impostorClip;          // clip-space position of this point
+out vec4 impostorClipAxis;      // and of impostorDepthAxis
+
+uniform samplerBuffer instanceTransforms;
+uniform int instanceOffset;  // first instance of this draw call (mirrored instances draw separately)
+
+layout(std140) uniform CameraTransforms {
+  mat4 view;
+  mat4 projection;
+  mat4 infiniteProjection;
+}
+cameraTransforms;
+
+const float FRAMES = 8.0;
+
+vec3 gridToDirection(vec2 grid) {
+  vec2 e = grid * 2.0 - 1.0;
+  vec2 xy = vec2(e.x + e.y, e.x - e.y) * 0.5;
+  return normalize(vec3(xy, 1.0 - abs(xy.x) - abs(xy.y)));
+}
+
+vec2 directionToGrid(vec3 d) {
+  d.z = max(d.z, 0.0);  // from below the horizon, the horizon views
+  d /= abs(d.x) + abs(d.y) + d.z;
+  return vec2(d.x + d.y, d.x - d.y) * 0.5 + 0.5;
+}
+
+void main() {
+  int instance = 3 * (gl_InstanceID + instanceOffset);
+  vec4 row0 = texelFetch(instanceTransforms, instance);
+  vec4 row1 = texelFetch(instanceTransforms, instance + 1);
+  vec4 row2 = texelFetch(instanceTransforms, instance + 2);
+  mat3 basis = mat3(vec3(row0.x, row1.x, row2.x), vec3(row0.y, row1.y, row2.y), vec3(row0.z, row1.z, row2.z));
+  vec3 center = vec3(row0.w, row1.w, row2.w);
+
+  inverseViewMatrix = mat3(inverse(cameraTransforms.view));
+  vec3 eye = inverse(cameraTransforms.view)[3].xyz;
+  vec3 toEye = normalize(inverse(basis) * (eye - center));
+
+  // The three views around the camera's direction: a triangle of the grid cell holding it.
+  vec2 grid = directionToGrid(toEye) * (FRAMES - 1.0);
+  vec2 cell = min(floor(grid), vec2(FRAMES - 2.0));
+  vec2 f = grid - cell;
+  bool lower = f.x > f.y;
+  vec2 corners[3] = vec2[3](cell, cell + 1.0, cell + (lower ? vec2(1.0, 0.0) : vec2(0.0, 1.0)));
+  vec3 weights = lower ? vec3(1.0 - f.x, f.y, f.x - f.y) : vec3(1.0 - f.y, f.x, f.y - f.x);
+
+  // The quad faces the camera. Each view is read where the view ray through this corner
+  // crosses that view's plane (through the origin, facing the view).
+  vec3 right = normalize(cross(vec3(0.0, 0.0, 1.0), toEye));
+  vec3 up = cross(toEye, right);
+  // At the front of the capture sphere, so texel depths only push fragments back (pbr.frag).
+  vec3 local = right * vCoord.x + up * vCoord.y + toEye;
+  for (int k = 0; k < 3; ++k) {
+    vec3 d = gridToDirection(corners[k] / (FRAMES - 1.0));
+    vec3 r = normalize(cross(vec3(0.0, 0.0, 1.0), d));
+    vec3 u = cross(d, r);
+    vec3 q = local - toEye * (dot(local, d) / dot(toEye, d));
+    impostorLocal[k] = vec3(vec2(dot(q, r), dot(q, u)) * 0.5 + 0.5, weights[k]);
+    impostorCell[k] = corners[k];
+  }
+
+  worldPosition = center + basis * local;
+  vec4 viewPosition = cameraTransforms.view * vec4(worldPosition, 1.0);
+  fragmentPosition = viewPosition.xyz;
+  gl_Position = cameraTransforms.infiniteProjection * viewPosition;
+  impostorClip = gl_Position;
+
+  mat3 rotation = mat3(normalize(basis[0]), normalize(basis[1]), normalize(basis[2]));
+  impostorToView = mat3(cameraTransforms.view) * rotation;
+  fragmentNormal = impostorToView * toEye;
+  impostorDepthAxis = basis * toEye;
+  impostorClipAxis = cameraTransforms.infiniteProjection * cameraTransforms.view * vec4(impostorDepthAxis, 0.0);
+  texUv = (corners[0] + vec2(impostorLocal[0].x, 1.0 - impostorLocal[0].y)) / FRAMES;
+  penTexUv = vec2(0.0);
+}
