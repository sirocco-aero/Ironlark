@@ -13,6 +13,10 @@ in vec2 texUv;
 in vec2 penTexUv;
 in mat3 inverseViewMatrix;
 
+// The mean of the normals a pixel covers, in view space: shorter where they disagree (minified
+// normal maps). Direct light uses it through a first-order model (PBRpass).
+vec3 meanNormal;
+
 layout(location = 0) out vec4 fragColor;
 layout(location = 1) out vec4 fragNormal;
 
@@ -74,6 +78,7 @@ layout(std140) uniform PbrMaterial {
   vec4 normalBrdfEmissiveBackgroundFlags;
   vec4 penFlags;
   vec4 cubeTextureFlags;
+  vec4 alphaCutoff;
 }
 material;
 
@@ -117,11 +122,23 @@ mat3 cotangentFrame(vec3 N, vec3 p, vec2 uv) {
   return mat3(T * invmax, B * invmax, N);
 }
 
+// Sets meanNormal. Minified past a few texels per pixel, a normal map's detail is sub-pixel, and
+// the frame built from screen derivatives breaks down once a pixel quad spans several small
+// triangles (needles), turning normals at random. There the mipmapped normal's length, how much
+// its texels disagree, shades instead.
 vec3 perturbNormal(vec3 N, vec3 V) {
   vec3 map = texture(inputTextures[4], texUv).rgb * 2.0 - 1.0;
   map.xy = vec2(material.roughnessMetalnessNormalMapFactorOcclusion.z) * map.xy;
+  vec2 texel = texUv * vec2(textureSize(inputTextures[4], 0));
+  float mip = 0.5 * log2(max(dot(dFdx(texel), dFdx(texel)), dot(dFdy(texel), dFdy(texel))));
   mat3 TBN = cotangentFrame(N, -V, texUv);
-  return normalize(TBN * map);
+  // A pixel quad over several tiny triangles can leave the frame degenerate (inf or NaN): the
+  // mix below would carry the NaN through even at zero weight, and the pixel would render black.
+  vec3 detailed = TBN * map;
+  float detailedLength = dot(detailed, detailed);
+  detailed = detailedLength > 1e-12 && detailedLength < 1e12 ? detailed * inversesqrt(detailedLength) : N;
+  meanNormal = mix(detailed, N * clamp(map.z, 0.0, 1.0), smoothstep(1.0, 3.0, mip));
+  return dot(meanNormal, meanNormal) > 1e-12 ? normalize(meanNormal) : N;
 }
 
 // Basic Lambertian diffuse
@@ -205,16 +222,26 @@ vec3 PBRpass(vec3 l, vec3 n, vec3 v, vec3 h, vec4 lightColorAndIntensity, float
   // diffuse light scale with intensity squared.
   vec3 diffuseContrib = (1.0 - F) * diffuse(pbrInputs);
   vec3 specContrib = F * G * D / (4.0 * NdotL * NdotV);
+  // A pixel covering many surfaces (needles): the cosine of their mean normal, which the
+  // disagreeing normals shorten (and so darken). The first-order mean clamped cosine (1/4 + mean
+  // normal . l / 2) lit needles facing away from the sun by a quarter of it: without a crown's
+  // shading of its own needles, backlit crowns glowed where a path tracer has them near black.
+  NdotL = max(dot(meanNormal, l), 0.0);
   // Obtain final intensity as reflectance (BRDF) scaled by the energy of the light (cosine law)
   color = NdotL * lightColorAndIntensity.xyz * (diffuseContrib + specContrib) * lightColorAndIntensity.w;
 
   return color;
 }
 
+
 void main() {
   vec3 viewFragmentNormal = normalize(reverseNormals ? -fragmentNormal : fragmentNormal);
+  // Back faces are only drawn for two-sided (alpha-masked) materials: shade them facing the viewer.
+  if (!gl_FrontFacing)
+    viewFragmentNormal = -viewFragmentNormal;
   fragNormal = vec4(normalize(viewFragmentNormal), 1.0) * 0.5 + 0.5;
 
+  meanNormal = viewFragmentNormal;
   // sample from normal map if one exists
   if (material.normalBrdfEmissiveBackgroundFlags.x > 0.0)
     viewFragmentNormal = perturbNormal(viewFragmentNormal, normalize(-fragmentPosition));
@@ -261,6 +288,17 @@ void main() {
     baseColor = vec4(baseColor.rgb * material.baseColorAndTransparency.rgb, baseColor.w);
   }
 
+  // Alpha mask (glTF MASK): each texel is kept or discarded, never blended.
+  // Mipmaps average alpha and would thin distant foliage, so alpha is scaled
+  // by the sampled mip level to preserve coverage.
+  if (material.alphaCutoff.x > 0.0) {
+    vec2 texel = texUv * vec2(textureSize(inputTextures[0], 0));
+    float mip = max(0.0, 0.5 * log2(max(dot(dFdx(texel), dFdx(texel)), dot(dFdy(texel), dFdy(texel)))));
+    if (baseColor.w * (1.0 + 0.25 * mip) < material.alphaCutoff.x)
+      discard;
+    baseColor.w = 1.0 - material.baseColorAndTransparency.w;
+  }
+
   // Mix with pen texture
   if (material.penFlags.x > 0.0) {
     vec4 penColor = texture(inputTextures[8], penTexUv);
