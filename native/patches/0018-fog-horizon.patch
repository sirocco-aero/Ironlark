+  float tNear = min(tEnd, max(tStart, MAX_DISTANCE * rayScale));
+  float stepLength = (tNear - tStart) / float(STEPS);
   float offset = dither(gl_FragCoord.xy);
   vec3 transmittance = vec3(1.0);
