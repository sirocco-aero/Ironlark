+  void Renderable::setInstances(const float *rows, int count) {
+    // Mirrored instances (negative determinant) wind their faces the other way: store them
+    // last, to draw them in a second call with the front face inverted.
+    mInstances.clear();
+    mInstances.reserve(12 * count);
