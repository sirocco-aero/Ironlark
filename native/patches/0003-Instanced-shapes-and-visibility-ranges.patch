+void WbShape::updateInstances() {
+  mInstances.clear();
+  if (mInstancesUrl->size() > 0) {
+    const QString path = WbUrl::computePath(this, "instancesUrl", mInstancesUrl, 0, true);
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly))
+      warn(tr("Cannot read instances file: '%1'").arg(path));
+    else {
+      const QByteArray data = file.readAll();
+      if (data.size() % (12 * sizeof(float)))
+        warn(tr("'%1' is not a whole number of 3x4 float32 transforms.").arg(path));
+      else {
+        mInstances.resize(data.size() / sizeof(float));
+        memcpy(mInstances.data(), data.constData(), data.size());
+      }
+    }
+  }
+  applyInstancingToGeometry();
+}
+
+void WbShape::applyInstancingToGeometry() {
+  WbGeometry *const g = geometry();
+  if (!g || !g->wrenRenderable() || g->isInBoundingObject())
+    return;
+  WrRenderable *renderable = g->wrenRenderable();
+  const WbVector2 &range = mVisibilityRange->value();
+  wr_renderable_set_visibility_range(renderable, range.x(), range.y());
+  if (mInstances.empty())
+    return;
+  wr_renderable_set_instances(renderable, mInstances.data(), static_cast<int>(mInstances.size() / 12));
+  wr_renderable_set_scene_culling(renderable, false);  // culled per instance
+  if (mWrenMaterial && mWrenMaterial->type == WR_MATERIAL_PBR) {
+    wr_material_set_default_program(mWrenMaterial, WbWrenShaders::pbrInstancedShader());
+    wr_material_set_stencil_ambient_emissive_program(mWrenMaterial, NULL);
+    wr_material_set_stencil_diffuse_specular_program(mWrenMaterial, NULL);
+  }
+}
+
 void WbShape::updateCastShadows() {
   assert(!isInBoundingObject());
 
@@ -295,8 +349,10 @@ void WbShape::applyMaterialToGeometry() {
