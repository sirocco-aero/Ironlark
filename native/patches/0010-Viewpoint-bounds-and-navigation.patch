+namespace {
+  struct RayProbe {
+    double nearest;  // distance along the ray to the nearest contact
+  };
+
+  void probeRay(void *data, dGeomID ray, dGeomID geom) {
+    if (dGeomIsSpace(geom)) {
+      dSpaceCollide2(ray, geom, data, &probeRay);
+      return;
+    }
+    RayProbe *probe = static_cast<RayProbe *>(data);
+    dContactGeom contact;
+    if (dCollide(ray, geom, 1, &contact, sizeof(dContactGeom)) > 0)
+      probe->nearest = std::min(probe->nearest, static_cast<double>(contact.depth));
+  }
+}  // namespace
+
+double WbViewpoint::castRay(const WbVector3 &origin, const WbVector3 &direction, double length) const {
+  WbOdeContext *ode = WbOdeContext::instance();
+  if (!ode || !ode->space() || direction.isNull())
+    return -1.0;
+  const WbVector3 unit = direction.normalized();
+  dGeomID ray = dCreateRay(NULL, length);
+  dGeomRaySet(ray, origin.x(), origin.y(), origin.z(), unit.x(), unit.y(), unit.z());
+  RayProbe probe = {INFINITY};
+  dSpaceCollide2(ray, reinterpret_cast<dGeomID>(ode->space()), &probe, &probeRay);
+  dGeomDestroy(ray);
+  return std::isfinite(probe.nearest) ? probe.nearest : -1.0;
+}
+
+bool WbViewpoint::isWithinBounds(const WbVector3 &point) const {
+  const WbVector3 &low = mBoundsMin->value(), &high = mBoundsMax->value();
+  for (int i = 0; i < 3; ++i)
+    if (low[i] < high[i] && (point[i] < low[i] || point[i] > high[i]))
+      return false;
+  return true;
+}
+
+// Keeps the viewpoint inside its bounds and above the solid below it, so navigation slides
+// along those limits instead of leaving the world.
+WbVector3 WbViewpoint::constrainedPosition(const WbVector3 &position) const {
+  WbVector3 p = position;
+  const WbVector3 &low = mBoundsMin->value(), &high = mBoundsMax->value();
+  for (int i = 0; i < 3; ++i)
+    if (low[i] < high[i])
+      p[i] = qBound(low[i], p[i], high[i]);
+
+  const double clearance = mGroundClearance->value();
+  if (clearance > 0.0) {
+    // Cast from high above straight down: the first hit is the ground (or object) below.
+    const double from = p.z() + 1000.0;
+    const double distance = castRay(WbVector3(p.x(), p.y(), from), WbVector3(0.0, 0.0, -1.0), 2000.0);
+    if (distance >= 0.0)
+      p.setZ(std::max(p.z(), from - distance + clearance));
+  }
+  return p;
+}
+
 void WbViewpoint::updatePosition() {
+  const WbVector3 constrained = constrainedPosition(mPosition->value());
+  if (constrained != mPosition->value()) {
+    mPosition->setValue(constrained);  // re-emits changed, which applies it
+    return;
+  }
   if (areWrenObjectsInitialized()) {
     applyPositionToWren();
     emit cameraParametersChanged();
