+WrPostProcessingEffect *WbWrenPostProcessingEffects::scatteringFog(float width, float height,
+                                                                   WrTextureInternalFormat textureFormat,
+                                                                   WrTexture *depthTexture, WrTexture *occlusionTexture) {
+  WrPostProcessingEffect *fogEffect = wr_post_processing_effect_new();
+  wr_post_processing_effect_set_drawing_index(fogEffect, WbWrenRenderingContext::PP_SCATTERING_FOG);
+
+  WrPostProcessingEffectPass *fogPass = wr_post_processing_effect_pass_new();
+  wr_post_processing_effect_pass_set_name(fogPass, "scatteringFog");
+  wr_post_processing_effect_pass_set_program(fogPass, WbWrenShaders::scatteringFogShader());
+  wr_post_processing_effect_pass_set_output_size(fogPass, width, height);
+  wr_post_processing_effect_pass_set_alpha_blending(fogPass, false);
+  wr_post_processing_effect_pass_set_input_texture_count(fogPass, 3);
+  wr_post_processing_effect_pass_set_input_texture(fogPass, 1, depthTexture);
+  wr_post_processing_effect_pass_set_input_texture(fogPass, 2, occlusionTexture);
+  wr_post_processing_effect_pass_set_input_texture_interpolation(fogPass, 2, true);
+  for (int i = 0; i < 3; ++i)
+    wr_post_processing_effect_pass_set_input_texture_wrap_mode(fogPass, i, WR_TEXTURE_WRAP_MODE_CLAMP_TO_EDGE);
+  wr_post_processing_effect_pass_set_output_texture_count(fogPass, 1);
+  wr_post_processing_effect_pass_set_output_texture_format(fogPass, 0, textureFormat);
+  wr_post_processing_effect_append_pass(fogEffect, fogPass);
+
+  wr_post_processing_effect_set_result_program(fogEffect, WbWrenShaders::passThroughShader());
+
+  return fogEffect;
+}
