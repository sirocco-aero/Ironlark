+#ifndef WB_WREN_SCATTERING_FOG_HPP
+#define WB_WREN_SCATTERING_FOG_HPP
+
+#include "WbWrenAbstractPostProcessingEffect.hpp"
+
+#include <QtCore/QString>
+
+struct WrPostProcessingEffectPass;
+struct WrTexture2d;
+
+// Renders a Fog node of type "SCATTERING": single scattering in HDR, before bloom and tone mapping.
+class WbWrenScatteringFog : public WbWrenAbstractPostProcessingEffect {
+public:
+  WbWrenScatteringFog();
+  ~WbWrenScatteringFog() override;
+
+  void setup(WrViewport *viewport) override;
+  void detachFromViewport() override;
+
+  // All quantities linear and in world coordinates.
+  struct Medium {
+    float scattering[4];       // rgb: scattering coefficient per metre, a: anisotropy
+    float ambient[4];          // rgb: isotropic ambient radiance
+    float boxMin[4];           // w: 1 when bounded
+    float boxMax[4];
+    float sunDirection[2][4];  // towards the light; w: 1 when present
+    float sunRadiance[2][4];
+    float occlusionRect[4];    // world min xy, max xy of the occlusion map; zero when absent
+    float occlusionHeight[2];  // ground heights encoded by G = 0 and G = 1
+    QString occlusionPath;
+  };
+  void update(const Medium &medium);
+
+protected:
+  void applyParametersToWren() override;
+
+private:
+  void loadOcclusion(const QString &path);
+
+  WrPostProcessingEffectPass *mPass;
+  WrTexture2d *mOcclusionTexture;
+  QString mOcclusionPath;
+  Medium mMedium;
+};
+
+#endif
