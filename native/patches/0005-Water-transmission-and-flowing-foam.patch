+// Gradient noise and fractal sums with the parameters of Blender's Noise Texture node
+// (scale, detail, roughness, lacunarity, distortion), for procedural flowing foam.
+uint hash(uvec4 v) {
+  v = v * 1664525u + 1013904223u;
+  v.x += v.y * v.w;
+  v.y += v.z * v.x;
+  v.z += v.x * v.y;
+  v.w += v.y * v.z;
+  v ^= v >> 16u;
+  v.x += v.y * v.w;
+  v.y += v.z * v.x;
+  v.z += v.x * v.y;
+  v.w += v.y * v.z;
+  return v.x ^ v.y ^ v.z ^ v.w;
+}
+
+float gradient(uvec4 cell, vec4 offset) {
+  uint h = hash(cell);
+  // One of 32 edge directions of a 4D hypercube, as in improved Perlin noise.
+  vec4 g = vec4((h & 1u) != 0u ? 1.0 : -1.0, (h & 2u) != 0u ? 1.0 : -1.0, (h & 4u) != 0u ? 1.0 : -1.0,
+                (h & 8u) != 0u ? 1.0 : -1.0);
+  uint zero = (h >> 4u) & 3u;
+  g[zero] = 0.0;
+  return dot(g, offset);
+}
+
+float signedNoise(vec4 p) {
+  vec4 i = floor(p);
+  vec4 f = p - i;
+  vec4 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
+  uvec4 c = uvec4(ivec4(i) + 32768);
+  float result = 0.0;
+  for (int k = 0; k < 16; ++k) {
+    uvec4 corner = uvec4(k & 1, (k >> 1) & 1, (k >> 2) & 1, (k >> 3) & 1);
+    vec4 w = mix(1.0 - u, u, vec4(corner));
+    result += w.x * w.y * w.z * w.w * gradient(c + corner, f - vec4(corner));
+  }
+  return 0.8344 * result;
+}
+
+float fractalNoise(vec4 p, float detail, float roughness, float lacunarity) {
+  float sum = 0.0, amplitude = 1.0, total = 0.0, frequency = 1.0;
+  for (int i = 0; i <= int(detail); ++i) {
+    sum += signedNoise(p * frequency) * amplitude;
+    total += amplitude;
+    amplitude *= roughness;
+    frequency *= lacunarity;
+  }
+  return 0.5 * sum / total + 0.5;
+}
+
+vec4 distort(vec4 p, float distortion) {
+  return p + distortion * vec4(signedNoise(p + vec4(13.5, 71.2, 5.1, 29.7)), signedNoise(p + vec4(97.1, 3.3, 51.7, 8.4)),
+                               signedNoise(p + vec4(41.9, 88.8, 17.3, 63.2)), signedNoise(p + vec4(7.7, 35.6, 91.4, 44.1)));
+}
+
+float ramp(float x, float a, float b) {
+  return clamp((x - a) / (b - a), 0.0, 1.0);
+}
+
+// Foam of the source river material: its flow coordinates are the texture coordinates
+// (u along the river, v across it), animated at 24 frames per second.
+float flowFoam(vec2 flow) {
+  float frame = simulationTime * 24.0;
+  vec3 drifted = vec3(flow, 0.0) + vec3(0.37 + frame / 100.0, 0.0, 0.0);
+  vec4 speckle = distort(vec4(drifted, frame / 150.0) * 25.0, 1.43);
+  float speck = ramp(fractalNoise(speckle, 2.0, 0.5, 2.0), 0.603, 0.693);
+  vec4 swirl = distort(vec4(vec3(flow, 0.0) + vec3(0.74 + frame / 50.0, 0.0, 0.0), 0.0) * 13.0 + vec4(0.0, 0.0, 0.0, 19.3), 2.2);
+  float across = drifted.y + 2.0 * fractalNoise(swirl, 10.0, 1.0, 2.0) - 1.0;  // linear light
+  float band = across < 0.501 ? 0.888 * ramp(across, 0.37, 0.501) : 0.888 * (1.0 - ramp(across, 0.501, 0.617));
+  return band * speck;
+}
