+  float foam = material.transmission.y > 0.0 ? material.transmission.y * flowFoam(texUv) : 0.0;
+  if (material.transmission.y > 0.0) {  // uniform branch: derivatives stay defined
+    // Bump from the foam height, as the source's Bump node (distance 1, strength 0.205): the
+    // fully bumped normal, from screen derivatives, blended with the flat one by the strength.
+    vec3 dpdx = dFdx(fragmentPosition), dpdy = dFdy(fragmentPosition);
+    vec3 r1 = cross(dpdy, viewFragmentNormal), r2 = cross(viewFragmentNormal, dpdx);
+    float det = dot(dpdx, r1);
+    vec3 surfaceGradient = sign(det) * (dFdx(foam) * r1 + dFdy(foam) * r2);
+    vec3 bumped = normalize(abs(det) * viewFragmentNormal - surfaceGradient);
+    viewFragmentNormal = normalize(mix(viewFragmentNormal, bumped, 0.2053));
+  }
+  float transmitted = material.transmission.x * (1.0 - foam);
