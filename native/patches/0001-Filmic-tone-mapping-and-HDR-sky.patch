From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zaid <283011337+nottzaid@users.noreply.github.com>
Date: Tue, 29 Sep 2026 12:00:00 +0300
Subject: [PATCH] Filmic tone mapping and HDR sky

Blender's Filmic "Medium High Contrast" view as a 65^3 table
(textures/filmic_mhc_lut.png, baked by Blender: Ironlark's
tools/bake_filmic_lut.py) replaces 1 - e^(-x) plus gamma; it matches
Blender within 1.3/255 at the 99th percentile. Background accepts .hdr
faces for the visible sky, kept as half-float linear radiance instead
of 8-bit. PBR diffuse light no longer scales with intensity squared, so
a light's intensity equals Blender's sun strength.

Replaces these patches of the numbered series, with what each measured
as it landed (tools/profile_forest.py, GTX 1060 3 GB, i5-4670):
- 0005-filmic-tone-mapping: frame time unchanged
- 0006-hdr-background: +12 MB VRAM
- 0007-pbr-light-intensity-once
---
 resources/wren/shaders/hdr_resolve.frag       |  33 +++++++++++++-----
 resources/wren/shaders/pbr.frag               |   4 ++-
 .../shaders/pbr_stencil_diffuse_specular.frag |   4 ++-
 resources/wren/shaders/skybox.frag            |   4 ++-
 resources/wren/textures/filmic_mhc_lut.png    | Bin 0 -> 36292 bytes
 src/webots/nodes/WbBackground.cpp             |  33 +++++++++++++++---
 .../wren/WbWrenPostProcessingEffects.cpp      |  10 +++++-
 src/webots/wren/WbWrenShaders.cpp             |   6 ++++
 8 files changed, 76 insertions(+), 18 deletions(-)
 create mode 100644 resources/wren/textures/filmic_mhc_lut.png

diff --git a/resources/wren/shaders/hdr_resolve.frag b/resources/wren/shaders/hdr_resolve.frag
index f13e1e1f25be280a0a22d060c16a353649133e11..848592a26496a0b43c7ab2f2b80c0cb9604eb878 100644
--- a/resources/wren/shaders/hdr_resolve.frag
+++ b/resources/wren/shaders/hdr_resolve.frag
@@ -6,18 +6,33 @@ in vec2 texUv;
 
 layout(location = 0) out vec4 result;
 
-uniform sampler2D inputTextures[1];
+// 0: scene-linear HDR color, 1: Filmic lookup table
+uniform sampler2D inputTextures[2];
 
 uniform float exposure;
 
+// Blender's Filmic view with its "Medium High Contrast" look, baked as a 65³ table.
+// Samples lie on Filmic's log shaper, log2(x / 0.18) in [low, high]. Blue slices run
+// left to right; within a slice red runs along x and green along y. Output is sRGB.
+const float lutSize = 65.0;
+const float shaperLow = -12.473931188;
+const float shaperHigh = 12.526068812;
+
+vec3 filmic(vec3 color) {
+  vec3 t = clamp((log2(max(color, vec3(1e-10)) / 0.18) - shaperLow) / (shaperHigh - shaperLow), 0.0, 1.0);
+  t *= lutSize - 1.0;
+  float slice = floor(t.b);
+  float nextSlice = min(slice + 1.0, lutSize - 1.0);
+  vec2 texel = vec2(1.0 / (lutSize * lutSize), 1.0 / lutSize);
+  vec2 uv = (t.rg + 0.5) * texel;
+  // Adjacent pixels can jump between slices; derivative-based mip selection
+  // would blur the table, so always read its full-resolution level.
+  vec3 low = textureLod(inputTextures[1], uv + vec2(slice * lutSize * texel.x, 0.0), 0.0).rgb;
+  vec3 high = textureLod(inputTextures[1], uv + vec2(nextSlice * lutSize * texel.x, 0.0), 0.0).rgb;
+  return mix(low, high, t.b - slice);
+}
+
 void main() {
-  const float gamma = 2.2;
   vec3 hdrColor = texture(inputTextures[0], texUv).rgb;
-
-  // Exposure tone mapping
-  vec3 mapped = vec3(1.0) - exp(-hdrColor * exposure);
-  // Gamma correction
-  mapped = pow(mapped, vec3(1.0 / gamma));
-
-  result = vec4(mapped, 1.0);
+  result = vec4(filmic(hdrColor * exposure), 1.0);
 }
diff --git a/resources/wren/shaders/pbr.frag b/resources/wren/shaders/pbr.frag
index cb4d00ae0b1b6efffe3d6f436bf37a8e46f00a1b..d169235e3273691854656e33abdf1434d2823f84 100644
--- a/resources/wren/shaders/pbr.frag
+++ b/resources/wren/shaders/pbr.frag
@@ -201,7 +201,9 @@ vec3 PBRpass(vec3 l, vec3 n, vec3 v, vec3 h, vec4 lightColorAndIntensity, float
   float G = geometricOcclusion(pbrInputs);
   float D = microfacetDistribution(pbrInputs);
 
-  vec3 diffuseContrib = (1.0 - F) * diffuse(pbrInputs) * lightColorAndIntensity.w;
+  // Intensity is applied once, below, as for specular; applying it here too made
+  // diffuse light scale with intensity squared.
+  vec3 diffuseContrib = (1.0 - F) * diffuse(pbrInputs);
   vec3 specContrib = F * G * D / (4.0 * NdotL * NdotV);
   // Obtain final intensity as reflectance (BRDF) scaled by the energy of the light (cosine law)
   color = NdotL * lightColorAndIntensity.xyz * (diffuseContrib + specContrib) * lightColorAndIntensity.w;
diff --git a/resources/wren/shaders/pbr_stencil_diffuse_specular.frag b/resources/wren/shaders/pbr_stencil_diffuse_specular.frag
index 57cd61db89c5139c69812e3b1aff5a10163774ce..a30678e051d219249f836ed468318e6456cef5db 100644
--- a/resources/wren/shaders/pbr_stencil_diffuse_specular.frag
+++ b/resources/wren/shaders/pbr_stencil_diffuse_specular.frag
@@ -169,7 +169,9 @@ vec3 PBRpass(vec3 l, vec3 n, vec3 v, vec3 h, vec4 lightColorAndIntensity, float
   float G = geometricOcclusion(pbrInputs);
   float D = microfacetDistribution(pbrInputs);
 
-  vec3 diffuseContrib = (1.0 - F) * diffuse(pbrInputs) * lightColorAndIntensity.w;
+  // Intensity is applied once, below, as for specular; applying it here too made
+  // diffuse light scale with intensity squared.
+  vec3 diffuseContrib = (1.0 - F) * diffuse(pbrInputs);
   vec3 specContrib = F * G * D / (4.0 * NdotL * NdotV);
   // Obtain final intensity as reflectance (BRDF) scaled by the energy of the light (cosine law)
   color = NdotL * lightColorAndIntensity.xyz * (diffuseContrib + specContrib) * lightColorAndIntensity.w;
diff --git a/resources/wren/shaders/skybox.frag b/resources/wren/shaders/skybox.frag
index aefd48ce83cd69b626671ce0a82dff5478fb0ccf..4bfd8c99a6d6c85d6c3e161e6ac5b5445728c56a 100644
--- a/resources/wren/shaders/skybox.frag
+++ b/resources/wren/shaders/skybox.frag
@@ -9,10 +9,12 @@ layout(location = 1) out vec3 fragNormal;
 in vec3 texUv;
 
 uniform samplerCube cubeTextures[1];
+uniform float linear;  // 1: HDR radiance, 0: 8-bit image needing decoding
 
 void main() {
   // invert z components of sample vector due to VRML default camera orientation looking towards -z
   fragNormal = vec3(0.0);
   fragColor = textureLod(cubeTextures[0], vec3(texUv.xy, -texUv.z), 0.0);
-  fragColor.rgb = pow(fragColor.rgb, vec3(GAMMA));
+  if (linear < 0.5)
+    fragColor.rgb = pow(fragColor.rgb, vec3(GAMMA));
 }
