+  // Triangle order from meshoptimizer. It takes a while for large meshes, so it is kept beside the parsed meshes
+  // (WEBOTS_MESH_CACHE) under the hash of the indices it was computed from.
+  static void orderForVertexCache(std::vector<unsigned int> &indices, size_t vertexCount) {
+    const size_t bytes = indices.size() * sizeof(unsigned int);
+    const uint64_t source = cache::sipHash13c(reinterpret_cast<const char *>(indices.data()), bytes);
+    const char *directory = getenv("WEBOTS_MESH_CACHE");
+    const std::string path = directory && *directory ? std::string(directory) + "/" + std::to_string(source) + ".order" : "";
+    if (!path.empty()) {
+      FILE *file = fopen(path.c_str(), "rb");
+      if (file) {
+        uint64_t count = 0;
+        std::vector<unsigned int> ordered(indices.size());
+        const bool read = fread(&count, sizeof(count), 1, file) == 1 && count == indices.size() &&
+                          fread(ordered.data(), 1, bytes, file) == bytes;
+        fclose(file);
+        if (read) {
+          indices.swap(ordered);
+          return;
+        }
+      }
+    }
+    meshopt_optimizeVertexCache(indices.data(), indices.data(), indices.size(), vertexCount);
+    if (!path.empty()) {
+      const std::string temporary = path + "." + std::to_string(getpid());
+      FILE *file = fopen(temporary.c_str(), "wb");
+      if (file) {
+        const uint64_t count = indices.size();
+        const bool written = fwrite(&count, sizeof(count), 1, file) == 1 && fwrite(indices.data(), 1, bytes, file) == bytes;
+        if (fclose(file) == 0 && written)
+          rename(temporary.c_str(), path.c_str());
+        else
+          remove(temporary.c_str());
+      }
+    }
+  }
+
+  template<typename T> static void permuteValues(std::vector<T> &values, const std::vector<unsigned int> &order) {
