diff --git a/src/wren/ShadowMap.cpp b/src/wren/ShadowMap.cpp
index 2e2d6c0..c40377e 100644
--- a/src/wren/ShadowMap.cpp
+++ b/src/wren/ShadowMap.cpp
@@ -44,6 +44,10 @@ namespace wren {
   // Far cascades cover this much more than the view needs, so the camera can move within
   // them before they must be redrawn.
   static const float CASCADE_SLACK = 1.25f;
+  // Casters pick their level of detail (visibility range) from the eye: a cascade drawn from
+  // farther than this would keep coarse hulls around fine meshes now shown near the viewer,
+  // which then shade themselves.
+  static const float EYE_SLACK = 1.0f;
 
   ShadowMap::ShadowMap(ShaderProgram *program, ShaderProgram *instancedProgram, int size, float maxDistance) :
     mProgram(program),
@@ -137,7 +141,8 @@ namespace wren {
 
       if (cascade > 0) {
         if (!refresh && mCachedRadius[cascade] > 0.0f &&
-            glm::distance(center, mCachedCenter[cascade]) + radius <= mCachedRadius[cascade]) {
+            glm::distance(center, mCachedCenter[cascade]) + radius <= mCachedRadius[cascade] &&
+            glm::distance(eye, mCachedEye[cascade]) <= EYE_SLACK) {
           start = end;
           continue;  // still covers the view: keep its depth and matrix
         }
@@ -171,6 +176,7 @@ namespace wren {
       mShadows.mTexelSizes[cascade] = texel;
       mCachedCenter[cascade] = center;
       mCachedRadius[cascade] = radius;
+      mCachedEye[cascade] = eye;
       start = end;
     }
 
